// Shared wire protocol helpers (depends on constants.nvgt + wire.nvgt).

#include "constants.nvgt"
#include "wire.nvgt"

// Deterministic 2-decimal coordinate formatting (avoids float noise & "-0.00").
string fmt2(double v) {
	int64 scaled = int64(v >= 0.0 ? v * 100.0 + 0.5 : v * 100.0 - 0.5);
	if (scaled == 0) return "0.00";
	bool neg = scaled < 0;
	if (neg) scaled = -scaled;
	int64 whole = scaled / 100;
	int64 frac = scaled % 100;
	string frac_str = frac < 10 ? "0" + frac : "" + frac;
	return (neg ? "-" : "") + whole + "." + frac_str;
}

int round_coord(double v) {
	return int(v >= 0.0 ? v + 0.5 : v - 0.5);
}

string join_wire(string[]@ parts) {
	if (@parts == null || parts.length() == 0) return "";
	string out_str = parts[0];
	for (uint i = 1; i < parts.length(); i++) {
		out_str += FIELD_SEP + parts[i];
	}
	return out_str;
}

string pkt_build(const string&in op, string[]@ fields = null) {
	if (@fields == null || fields.length() == 0) return op;
	return op + FIELD_SEP + join_wire(fields);
}

string pkt_2(const string&in op, const string&in a) {
	return op + FIELD_SEP + a;
}

string pkt_3(const string&in op, const string&in a, const string&in b) {
	return op + FIELD_SEP + a + FIELD_SEP + b;
}

string pkt_4(const string&in op, const string&in a, const string&in b, const string&in c) {
	return op + FIELD_SEP + a + FIELD_SEP + b + FIELD_SEP + c;
}

string pkt_5(const string&in op, const string&in a, const string&in b, const string&in c, const string&in d) {
	return op + FIELD_SEP + a + FIELD_SEP + b + FIELD_SEP + c + FIELD_SEP + d;
}

string[]@ pkt_parse(const string&in raw) {
	return split_keep_empty(raw, FIELD_SEP);
}

string pkt_op(string[]@ parts) {
	return field(parts, 0, "");
}

bool fits_udp(const string&in payload) {
	return payload.length() <= uint(MAX_UDP_PAYLOAD);
}

// Strip ASCII control chars from chat/input lines while preserving readable text.
string strip_control_chars(const string&in s, uint max_len = MAX_CHAT_LEN) {
	string res = "";
	for (uint i = 0; i < s.length() && res.length() < max_len; i++) {
		string ch = s.substr(i, 1);
		uint8 b = character_to_ascii(ch);
		if (b < 32 || b == 127) continue;
		res += ch;
	}
	return res.trim_whitespace();
}

string non_empty_or_dash(const string&in s) {
	return s.length() == 0 ? "-" : wire_escape(s);
}

string unescape_or_empty(const string&in s) {
	if (s == "-") return "";
	return wire_unescape(s);
}

string pad2(int64 v) {
	return v < 10 ? "0" + v : "" + v;
}

// Convert POSIX epoch seconds (with optional tz_offset_sec) into YYYY-MM-DD HH:MM using Howard Hinnant's civil-from-days algorithm.
string format_epoch_datetime(int64 epoch_sec, int tz_offset_sec = 0) {
	if (epoch_sec <= 0) return "never";
	int64 local_s = epoch_sec + int64(tz_offset_sec);
	int64 z = local_s / 86400;
	int64 rem = local_s % 86400;
	if (rem < 0) {
		rem += 86400;
		z -= 1;
	}
	int64 hour = rem / 3600;
	int64 minute = (rem % 3600) / 60;

	z += 719468;
	int64 era = (z >= 0 ? z : z - 146096) / 146097;
	int64 doe = z - era * 146097;
	int64 yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
	int64 y = yoe + era * 400;
	int64 doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
	int64 mp = (5 * doy + 2) / 153;
	int64 d = doy - (153 * mp + 2) / 5 + 1;
	int64 m = mp + (mp < 10 ? 3 : -9);
	if (m <= 2) y += 1;

	return y + "-" + pad2(m) + "-" + pad2(d) + " " + pad2(hour) + ":" + pad2(minute);
}

string format_last_seen_en(int64 last_seen_epoch, int64 now_sec, int tz_offset_sec = 0) {
	if (last_seen_epoch <= 0) return "never logged in";
	int64 diff = now_sec - last_seen_epoch;
	if (diff < 0) diff = 0;
	string rel;
	if (diff < 60) rel = "just now";
	else if (diff < 3600) {
		int64 m = diff / 60;
		rel = m + (m == 1 ? " minute ago" : " minutes ago");
	} else if (diff < 86400) {
		int64 h = diff / 3600;
		rel = h + (h == 1 ? " hour ago" : " hours ago");
	} else {
		int64 days = diff / 86400;
		rel = days + (days == 1 ? " day ago" : " days ago");
	}
	return rel + " (" + format_epoch_datetime(last_seen_epoch, tz_offset_sec) + ")";
}

string format_uptime_words(uint64 sec) {
	if (sec == 0) return "0 seconds";
	uint64 days = sec / 86400;
	uint64 hours = (sec % 86400) / 3600;
	uint64 mins = (sec % 3600) / 60;
	uint64 secs = sec % 60;
	string[] parts;
	if (days > 0) parts.insert_last(days + (days == 1 ? " day" : " days"));
	if (hours > 0) parts.insert_last(hours + (hours == 1 ? " hour" : " hours"));
	if (mins > 0) parts.insert_last(mins + (mins == 1 ? " minute" : " minutes"));
	if (secs > 0 || parts.length() == 0) parts.insert_last(secs + (secs == 1 ? " second" : " seconds"));
	string res = parts[0];
	for (uint i = 1; i < parts.length(); i++) res += ", " + parts[i];
	return res;
}
