// Client acoustic sonar echolocation sweep and vitals/coords HUD readouts.
// Legacy T-scanner retired; STW-style tracking lives in tracker.nvgt.

#include "tracker.nvgt"

void trigger_sonar_sweep(NetClient@ nc) {
	if (!nc.snap_received) return;
	TrackerTarget@[] list = g_tracker.collect(nc, TRK_CAT_ALL, TRACKER_MAX_DIST);
	int played = 0;
	for (uint i = 0; i < list.length() && played < 3; i++) {
		TrackerTarget@ rt = list[i];
		g_audio.play_world_sfx("world", "ui/sonar_ping.ogg", rt.x, rt.y, rt.z, 0.75f, true);
		played++;
	}

	double bx = bearing_x(double(nc.my_facing));
	double by = bearing_y(double(nc.my_facing));
	string wall_mat;
	bool blocked_ahead = false;
	double hit_dist = 0.0;
	for (int s = 1; s <= 5; s++) {
		double tx = nc.my_x + bx * double(s);
		double ty = nc.my_y + by * double(s);
		if (nc.map_loaded && nc.map.blocked_by_wall(tx, ty, nc.my_z, PLAYER_RADIUS, wall_mat)) {
			blocked_ahead = true;
			hit_dist = double(s);
			g_audio.play_world_sfx("world", wall_mat == "stone" ? "steps/wall_bump_stone.ogg" : "steps/wall_bump_wood.ogg", tx, ty, nc.my_z, 0.65f, false);
			break;
		}
	}
	if (blocked_ahead) {
		say(wall_mat + " obstacle " + int(hit_dist) + " steps ahead.", true);
	} else if (played > 0) {
		TrackerTarget@ near = list[0];
		say("Path clear ahead. Nearest: " + describe_target(near.label, double(nc.my_facing), nc.my_x, nc.my_y, nc.my_z, near.x, near.y, near.z), true);
	} else {
		g_audio.play_ui_cue("ui/sonar_ping.ogg", 0.55f);
		say("Open ground all around.", true);
	}
}

void speak_vitals_hud(NetClient@ nc) {
	if (!nc.snap_received) { say("Waiting for world state.", true); return; }
	string weather = nc.is_raining ? "raining" : "clear skies";
	string tod = nc.is_night ? "nighttime" : "daylight";
	string frac = nc.my_fractured ? " Fractured leg." : "";
	say("Health " + nc.my_hp + ", hunger " + nc.my_hunger + ", thirst " + nc.my_thirst
		+ ", stamina " + nc.my_stamina + ", warmth " + nc.my_warmth
		+ "." + frac + " " + tod + ", " + weather + ".", true);
}

void speak_coords_hud(NetClient@ nc) {
	if (!nc.snap_received) return;
	string surf = nc.map_loaded ? nc.map.surface_at(nc.my_x, nc.my_y, nc.my_z) : "ground";
	double sz; string ss; bool dw, ur;
	bool air = nc.map_loaded && !nc.map.find_support_at(nc.my_x, nc.my_y, nc.my_z, sz, ss, dw, ur) && (@nc.map.find_stair_at(nc.my_x, nc.my_y, nc.my_z) == null);
	string mname = nc.current_map_name.length() > 0 ? nc.current_map_name + ", " : "";
	say(mname + nc.cur_zone + ", X " + int(nc.my_x + 0.5) + ", Y " + int(nc.my_y + 0.5) + ", Z " + int(nc.my_z + (nc.my_z < 0 ? -0.5 : 0.5)) + ", " + (air ? "in mid-air" : ("standing on " + surf)) + ".", true);
}

void speak_compass_hud(NetClient@ nc) {
	say("Facing " + compass_name(double(nc.my_facing)) + ", " + nc.my_facing + " degrees.", true);
}
