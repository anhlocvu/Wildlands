// Client spatial audio engine: 7-layer mixers, linear->dB mapping, Steam Audio HRTF,
// acoustic wall low-pass occlusion, adaptive zone ambience crossfader, and buffered UI cues.

#include "speech.nvgt"
#include "profile.nvgt"
#include "sound_pool.nvgt"
#include "../../common/compass.nvgt"
#include "../../common/map.nvgt"

float clampf(float v, float lo, float hi) {
	return v < lo ? lo : (v > hi ? hi : v);
}

// Convert linear gain [0.0 .. 1.0] into NVGT dB scale [-100.0 .. 0.0].
float linear_to_db(float linear) {
	if (linear <= 0.0001f) return -100.0f;
	float db = float(20.0 * log10(double(clampf(linear, 0.0001f, 1.0f))));
	return clampf(db, -100.0f, 0.0f);
}

string g_sound_root = "sounds/";
bool g_audio_silent = false;

void resolve_sound_root() {
	if (directory_exists("sounds/ui")) g_sound_root = "sounds/";
	else if (directory_exists("client/sounds/ui")) g_sound_root = "client/sounds/";
	else g_sound_root = "sounds/";
}

string sfx_path(const string&in rel) {
	if (rel.starts_with(g_sound_root)) return rel;
	return g_sound_root + rel;
}

class AudioEngine {
	sound_pool pool;
	WorldMap@ active_map = null;

	mixer@ mix_self = null;
	mixer@ mix_steps = null;
	mixer@ mix_threat = null;
	mixer@ mix_actors = null;
	mixer@ mix_world = null;
	mixer@ mix_ambience = null;
	mixer@ mix_music = null;
	string active_reverb_preset = "none";

	// Persistent music / ambient streams
	sound@ menu_bgm = null;
	float menu_bgm_gain = 0.0f;
	bool menu_bgm_target = false;

	sound@ amb_curr = null;
	sound@ amb_prev = null;
	string amb_curr_path = "";
	float amb_fade = 1.0f;

	sound@ rain_loop = null;
	float rain_gain = 0.0f;

	int[] emitter_slots;
	string[] emitter_paths;
	timer occlude_timer;

	double listener_x = 0.0;
	double listener_y = 0.0;
	double listener_z = 0.0;
	int listener_facing = 0;

	int[] cached_layer_pct;
	bool initialized = false;

	void init(bool headless_silent, ClientProfile@ prof) {
		g_audio_silent = headless_silent;
		g_speech_silent = headless_silent;
		resolve_sound_root();
		cached_layer_pct = {100, 85, 95, 85, 85, 65, 45};

		if (g_audio_silent) {
			initialized = true;
			return;
		}

		@mix_self = mixer();
		@mix_steps = mixer();
		@mix_threat = mixer();
		@mix_actors = mixer();
		@mix_world = mixer();
		@mix_ambience = mixer();
		@mix_music = mixer();
		active_reverb_preset = "none";

		pool.y_is_elevation = false;
		pool.max_distance = int(EARSHOT_RADIUS);
		pool.pan_step = 4.0f;
		pool.volume_step = 1.6f;
		pool.behind_pitch_decrease = 3.0f;
		pool.hrtf = prof.hrtf_enabled;
		set_sound_global_hrtf(prof.hrtf_enabled);

		apply_profile(prof);
		initialized = true;
	}

	mixer@ mixer_for_tag(const string&in tag) {
		string t = tag.lower();
		if (t == "self" || t == "ui") return mix_self;
		if (t == "threat" || t == "combat") return mix_threat;
		if (t == "actors" || t == "wildlife" || t == "actor") return mix_actors;
		if (t == "ambience" || t == "ambient") return mix_ambience;
		if (t == "music") return mix_music;
		return mix_world;
	}

	void apply_profile(ClientProfile@ prof) {
		if (@prof == null) return;
		cached_layer_pct = prof.layer_pct;
		g_duck_enabled = prof.speech_ducking;
		apply_speech_prefs(prof.use_sr, prof.tts_rate, prof.layer_pct[LAYER_SPEECH], prof.tts_voice_name);
		if (g_audio_silent) return;

		pool.hrtf = prof.hrtf_enabled;
		set_sound_global_hrtf(prof.hrtf_enabled);
		update_mixer_gains();
	}

	void update_mixer_gains() {
		if (g_audio_silent || @mix_self == null) return;
		bool duck = is_speech_ducking_active();
		float duck_bg = duck ? 0.52f : 1.0f;
		float duck_mid = duck ? 0.78f : 1.0f;

		mix_self.volume = linear_to_db(float(cached_layer_pct[LAYER_SELF]) / 100.0f);
		if (@mix_steps != null) mix_steps.volume = mix_self.volume;
		mix_threat.volume = linear_to_db(float(cached_layer_pct[LAYER_THREAT]) / 100.0f);
		mix_actors.volume = linear_to_db((float(cached_layer_pct[LAYER_ACTORS]) / 100.0f) * duck_mid);
		mix_world.volume = linear_to_db((float(cached_layer_pct[LAYER_WORLD]) / 100.0f) * duck_mid);
		mix_ambience.volume = linear_to_db((float(cached_layer_pct[LAYER_AMBIENCE]) / 100.0f) * duck_bg);
		mix_music.volume = linear_to_db((float(cached_layer_pct[LAYER_MUSIC]) / 100.0f) * duck_bg);
	}

	void play_ui_cue(const string&in rel, float vol_scale = 1.0f) {
		if (g_audio_silent) return;
		string r = rel;
		if (r.find("/") < 0) r = "ui/" + r;
		string full = sfx_path(r);
		if (!file_exists(full)) return;
		sound_play(full, vector(FLOAT_MAX, FLOAT_MAX, FLOAT_MAX), linear_to_db(clampf(vol_scale, 0.0f, 1.0f)), 0.0f, 100.0f, mix_self);
	}

	void preview_layer_sample(int layer, ClientProfile@ prof) {
		apply_profile(prof);
		if (g_audio_silent) return;
		switch (layer) {
			case LAYER_SPEECH:
				say("Speech sample at " + prof.layer_pct[LAYER_SPEECH] + " percent.", true);
				break;
			case LAYER_SELF:
				play_ui_cue("steps/grass_1.ogg", 0.9f);
				break;
			case LAYER_THREAT:
				play_ui_cue("combat/swing_melee.ogg", 0.9f);
				break;
			case LAYER_ACTORS:
				play_ui_cue("wildlife/deer_call.ogg", 0.9f);
				break;
			case LAYER_WORLD:
				play_ui_cue("builder/build_place.ogg", 0.9f);
				break;
			case LAYER_AMBIENCE:
				play_ui_cue("ambience/wind_gust.ogg", 0.85f);
				break;
			case LAYER_MUSIC:
				play_ui_cue("ui/sonar_ping.ogg", 0.7f);
				break;
		}
	}

	void play_local_footstep(const string&in surface, bool landing = false) {
		if (g_audio_silent) return;
		string rel = "steps/grass_1.ogg";
		int v = random(1, 3);
		if (landing) rel = "steps/land_soft.ogg";
		else if (surface == "dirt") rel = "steps/dirt_" + v + ".ogg";
		else if (surface == "stone") rel = "steps/stone_" + v + ".ogg";
		else if (surface == "wood") rel = "steps/wood_" + v + ".ogg";
		else if (surface == "sand") rel = "steps/sand_" + v + ".ogg";
		else if (surface == "water") rel = "steps/water_" + v + ".ogg";
		else if (surface == "carpet") rel = "steps/carpet_" + v + ".ogg";
		else rel = "steps/grass_" + v + ".ogg";

		string full = sfx_path(rel);
		if (!file_exists(full)) return;
		sound_play(full, vector(FLOAT_MAX, FLOAT_MAX, FLOAT_MAX), linear_to_db(0.75f), 0.0f, 100.0f, @mix_steps != null ? mix_steps : mix_self);
	}

	void set_zone_reverb(const string&in preset_in) {
		string p = normalize_reverb_preset(preset_in);
		if (p == active_reverb_preset) return;
		active_reverb_preset = p;
		if (g_audio_silent || @mix_world == null) return;
		mixer@[] rev_mixers = {mix_steps, mix_world, mix_actors, mix_threat};
		for (uint i = 0; i < rev_mixers.length(); i++) {
			if (@rev_mixers[i] == null) continue;
			rev_mixers[i].effects_chain.clear(true);
			if (p != "none") {
				audio_freeverb_node@ fv = audio_freeverb_node();
				if (p == "room") {
					fv.room_size = 0.35f; fv.damping = 0.65f; fv.width = 0.65f; fv.wet = 0.16f; fv.dry = 0.90f;
				} else if (p == "hall") {
					fv.room_size = 0.72f; fv.damping = 0.42f; fv.width = 0.90f; fv.wet = 0.28f; fv.dry = 0.85f;
				} else {
					fv.room_size = 0.92f; fv.damping = 0.25f; fv.width = 1.00f; fv.wet = 0.42f; fv.dry = 0.80f;
				}
				rev_mixers[i].effects_chain.add_node(fv);
			}
		}
	}

	int play_world_sfx(const string&in layer_tag, const string&in rel, double sx, double sy, double sz, float vol_scale = 1.0f, bool check_occlude = true, bool looping = false, bool persistent = false) {
		if (g_audio_silent) return -1;
		string full = sfx_path(rel);
		if (!file_exists(full)) return -1;

		bool occluded = false;
		if (check_occlude && @active_map != null) {
			occluded = active_map.segment_occluded(listener_x, listener_y, listener_z + 1.2, sx, sy, sz + 0.8);
		}

		float gain = clampf(vol_scale, 0.0f, 1.0f) * (occluded ? 0.50f : 1.0f);
		mixer@ m = mixer_for_tag(layer_tag);
		bool auto_start = !occluded;
		int slot = pool.play_extended_3d(full, float(listener_x), float(listener_y), float(listener_z),
			float(sx), float(sy), float(sz), double(listener_facing),
			0, 0, 0, 0, 0, 0, looping, 0.0, 0.0f, linear_to_db(gain), 100.0f, persistent, m, null, auto_start, 0.0);

		if (slot >= 0 && occluded) {
			sound@ snd = pool.get_sound_handle(slot);
			if (@snd != null) {
				audio_low_pass_filter@ lp = audio_low_pass_filter(750.0, 2);
				snd.effects_chain.add_node(lp);
				snd.play();
			}
		}
		return slot;
	}

	void set_menu_music(bool enabled) {
		menu_bgm_target = enabled;
		if (g_audio_silent) return;
		if (enabled && @menu_bgm == null) {
			string full = sfx_path("music/menu_theme.ogg");
			if (file_exists(full)) {
				@menu_bgm = sound();
				if (menu_bgm.load(full)) {
					menu_bgm.set_mixer(mix_music);
					menu_bgm.volume = -100.0f;
					menu_bgm.play_looped();
					menu_bgm_gain = 0.05f;
				} else {
					@menu_bgm = null;
				}
			}
		}
	}

	void set_map(WorldMap@ m) {
		clear_emitters();
		@active_map = @m;
		if (g_audio_silent || @active_map == null) return;

		for (uint i = 0; i < active_map.emitters.length(); i++) {
			MapEmitter@ em = active_map.emitters[i];
			string full = sfx_path(em.sound_file);
			if (!file_exists(full)) continue;
			int slot = pool.play_extended_3d(full, float(listener_x), float(listener_y), float(listener_z),
				float(em.x), float(em.y), float(em.z), double(listener_facing),
				0, 0, 0, 0, 0, 0, true, 0.0, 0.0f, linear_to_db(float(clampd(em.volume, 0.05, 1.0))), 100.0f, true, mix_ambience, null, true, 0.0);
			emitter_slots.insert_last(slot);
			emitter_paths.insert_last(em.sound_file);
		}
	}

	void clear_emitters() {
		for (uint i = 0; i < emitter_slots.length(); i++) {
			if (emitter_slots[i] >= 0) pool.destroy_sound(emitter_slots[i]);
		}
		emitter_slots.resize(0);
		emitter_paths.resize(0);
	}

	void stop_world_audio() {
		clear_emitters();
		set_zone_reverb("none");
		if (@amb_curr != null) { amb_curr.stop(); @amb_curr = null; }
		if (@amb_prev != null) { amb_prev.stop(); @amb_prev = null; }
		if (@rain_loop != null) { rain_loop.stop(); @rain_loop = null; }
		amb_curr_path = "";
		pool.destroy_all();
	}

	void tick_menu_audio() {
		if (g_audio_silent) return;
		update_mixer_gains();
		tick_bgm(0.03f);
	}

	void tick_bgm(float step) {
		if (@menu_bgm == null) return;
		float target = menu_bgm_target ? 0.85f : 0.0f;
		if (menu_bgm_gain < target) {
			menu_bgm_gain = clampf(menu_bgm_gain + step, 0.0f, target);
		} else if (menu_bgm_gain > target) {
			menu_bgm_gain = clampf(menu_bgm_gain - step, target, 1.0f);
		}
		menu_bgm.volume = linear_to_db(menu_bgm_gain);
		if (!menu_bgm_target && menu_bgm_gain <= 0.005f) {
			menu_bgm.stop();
			@menu_bgm = null;
		}
	}

	void update_world(double px, double py, double pz, int facing, bool is_night, bool is_raining, const string&in zone_amb, bool under_roof = false) {
		listener_x = px;
		listener_y = py;
		listener_z = pz;
		listener_facing = facing;
		if (g_audio_silent) return;

		update_mixer_gains();
		tick_bgm(0.04f);

		// 1. Update listener FIRST so sound_pool applies rotation & attenuation cleanly
		pool.update_listener_3d(float(px), float(py), float(pz), double(facing));

		// 2. Adaptive zone ambient crossfade ("none" stops/silences loop cleanly; forest switches day/night seamlessly)
		string desired = normalize_amb_ref(zone_amb);
		if (desired == "ambience/forest_day.ogg" && is_night) desired = "ambience/forest_night.ogg";

		if (desired != amb_curr_path) {
			if (@amb_prev != null) { amb_prev.stop(); @amb_prev = null; }
			@amb_prev = @amb_curr;
			@amb_curr = null;
			if (desired != "none") {
				string full = sfx_path(desired);
				if (file_exists(full)) {
					@amb_curr = sound();
					if (amb_curr.load(full)) {
						amb_curr.set_mixer(mix_ambience);
						amb_curr.volume = -100.0f;
						amb_curr.play_looped();
					} else {
						@amb_curr = null;
					}
				}
			}
			amb_curr_path = desired;
			amb_fade = 0.0f;
		}

		if (amb_fade < 1.0f) {
			amb_fade = clampf(amb_fade + 0.025f, 0.0f, 1.0f);
			if (@amb_curr != null) amb_curr.volume = linear_to_db(0.60f * amb_fade);
			if (@amb_prev != null) {
				amb_prev.volume = linear_to_db(0.60f * (1.0f - amb_fade));
				if (amb_fade >= 0.99f) { amb_prev.stop(); @amb_prev = null; }
			}
		}

		// 3. Weather rain layer (softens under roof / indoor cover)
		float rain_target = is_raining ? (under_roof ? 0.22f : 0.55f) : 0.0f;
		if (is_raining && @rain_loop == null) {
			string full = sfx_path("ambience/rain_loop.ogg");
			if (file_exists(full)) {
				@rain_loop = sound();
				if (rain_loop.load(full)) {
					rain_loop.set_mixer(mix_ambience);
					rain_loop.volume = -100.0f;
					rain_loop.play_looped();
				} else {
					@rain_loop = null;
				}
			}
		}
		if (@rain_loop != null) {
			if (rain_gain < rain_target) rain_gain = clampf(rain_gain + 0.02f, 0.0f, rain_target);
			else if (rain_gain > rain_target) rain_gain = clampf(rain_gain - 0.02f, rain_target, 1.0f);
			rain_loop.volume = linear_to_db(rain_gain);
			if (!is_raining && rain_gain <= 0.005f) {
				rain_loop.stop();
				@rain_loop = null;
			}
		}

		// 4. Refresh positional emitters' loudness softly on occlusion tick (~250ms)
		if (occlude_timer.elapsed >= 250 && @active_map != null) {
			occlude_timer.restart();
			for (uint i = 0; i < emitter_slots.length() && i < active_map.emitters.length(); i++) {
				int slot = emitter_slots[i];
				if (slot < 0) continue;
				MapEmitter@ em = active_map.emitters[i];
				bool occ = active_map.segment_occluded(px, py, pz + 1.2, em.x, em.y, em.z + 0.8);
				float base_vol = float(clampd(em.volume, 0.05, 1.0)) * (occ ? 0.45f : 1.0f);
				pool.set_sound_volume(slot, linear_to_db(base_vol));
			}
		}

		pool.clean_unused();
	}
}

AudioEngine g_audio;

// Required global hook expected by client/includes/buffers.nvgt.
void play_ui(const string&in filename, float volume = 1.0) {
	g_audio.play_ui_cue(filename, volume);
}

#include "buffers.nvgt"
