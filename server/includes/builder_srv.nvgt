// Server Dual Builder System:
// 1. Survival Base Building (map-scoped structures, lockable doors, chests, repair, demolish)
// 2. STW-Style Multi-Map Audio Map Builder (Create Map, 6-axis Box Forms, Line Manager, Undo, Hot Reload)

#include "chat_social.nvgt"

WorldStructure@ builder_find_near(ServerCtx@ ctx, MapInstance@ mi, double x, double y, double z, double max_d = 2.6, const string&in filter_type = "") {
	WorldStructure@ best = null;
	double best_d = max_d;
	for (uint i = 0; i < ctx.structures.length(); i++) {
		WorldStructure@ st = ctx.structures[i];
		if (!ctx.struct_on_map(st, mi)) continue;
		if (filter_type.length() > 0 && st.type != filter_type) continue;
		double d = get_3d_distance(x, y, z, st.x, st.y, st.z);
		if (d <= best_d) { best_d = d; @best = @st; }
	}
	return best;
}

bool builder_can_access(ServerCtx@ ctx, PlayerSession@ ps, WorldStructure@ st) {
	if (ps.rank >= RANK_ADMIN) return true;
	if (st.owner.lower() == ps.name.lower()) return true;
	AccountRecord@ owner_acc = ctx.accounts.find(st.owner);
	if (@owner_acc != null && owner_acc.has_friend(ps.name.lower())) return true;
	return false;
}

void builder_place_structure(ServerCtx@ ctx, PlayerSession@ ps, const string&in raw_stype) {
	MapInstance@ mi = ctx.player_map(ps);
	if (@mi == null) return;
	if (!mi.map.allow_build && ps.rank < RANK_ADMIN) {
		ctx.send_sfx_to(ps, "self", "ui/error.ogg", ps.x, ps.y, ps.z, 0.7);
		ctx.send_speech(ps, MBUF_GAME, true, "Building is disabled on " + mi.map.name + ".");
		return;
	}
	string stype = raw_stype;
	if (stype.ends_with("_kit")) {
		ItemDef@ kd = find_item(stype);
		if (@kd != null && kd.build_type.length() > 0) stype = kd.build_type;
	}
	StructDef@ sdef = find_struct(stype);
	if (@sdef == null) { ctx.send_speech(ps, MBUF_GAME, true, "Unknown structure type."); return; }
	string kit_id = stype + "_kit";
	if (ps.count_item(kit_id) < 1) {
		ctx.send_sfx_to(ps, "self", "ui/error.ogg", ps.x, ps.y, ps.z, 0.7);
		ctx.send_speech(ps, MBUF_GAME, true, "You need a " + sdef.name + " Kit in your inventory.");
		return;
	}

	double tx = double(int(ps.x + bearing_x(ps.facing) * 1.6 + 0.5));
	double ty = double(int(ps.y + bearing_y(ps.facing) * 1.6 + 0.5));
	double tz = ps.z;
	double sz; string ss; bool dw; bool ur;
	if (mi.map.find_support_at(tx, ty, ps.z + 0.8, sz, ss, dw, ur)) tz = sz;

	if (tx < 2.0 || tx > double(mi.map.width - 2) || ty < 2.0 || ty > double(mi.map.height - 2)) {
		ctx.send_speech(ps, MBUF_GAME, true, "Cannot build outside map boundaries.");
		return;
	}
	string mat;
	if (sdef.blocks_move && mi.map.blocked_by_wall(tx, ty, tz, 0.4, mat)) {
		ctx.send_sfx_to(ps, "self", "ui/error.ogg", ps.x, ps.y, ps.z, 0.7);
		ctx.send_speech(ps, MBUF_GAME, true, "Space ahead is blocked.");
		return;
	}
	if (@builder_find_near(ctx, mi, tx, ty, tz, 0.9) != null) {
		ctx.send_sfx_to(ps, "self", "ui/error.ogg", ps.x, ps.y, ps.z, 0.7);
		ctx.send_speech(ps, MBUF_GAME, true, "Another structure is already there.");
		return;
	}

	ps.remove_item(kit_id, 1);
	WorldStructure st;
	st.id = ctx.next_entity_id++;
	st.map_name = mi.slug;
	st.type = stype;
	st.owner = ps.name;
	st.x = tx; st.y = ty; st.z = tz;
	st.facing = (ps.facing / 90) * 90;
	st.hp = sdef.max_hp;
	st.max_hp = sdef.max_hp;
	st.fuel_sec = sdef.is_campfire ? 240 : 0;
	ctx.structures.insert_last(st);

	if (stype == "wood_floor" || stype == "wood_stairs") {
		MapPlatform pl;
		pl.label = st.owner + " " + sdef.name;
		pl.min_x = tx - 1.5; pl.max_x = tx + 1.5;
		pl.min_y = ty - 1.5; pl.max_y = ty + 1.5;
		pl.min_z = tz;
		pl.max_z = tz + (stype == "wood_stairs" ? 3.0 : 0.2);
		pl.surface = "wood";
		pl.kind = stype == "wood_stairs" ? "stairs" : "floor";
		mi.map.platforms.insert_last(pl);
	}

	ctx.sync_map_occluders(mi);
	ctx.objects_dirty = true;
	if (@ps.account != null) { ps.account.built_count++; ctx.accounts.dirty = true; }
	ctx.broadcast_obj("add", st);
	string bsfx = sdef.is_campfire ? "survival/campfire_ignite.ogg" : "builder/build_place.ogg";
	ctx.broadcast_sfx_3d(mi.slug, "world", bsfx, st.x, st.y, st.z, 0.9, 25.0);
	ctx.send_speech(ps, MBUF_GAME, false, "Built " + sdef.name + ".");
	ctx.send_inv(ps);
}

void builder_interact(ServerCtx@ ctx, PlayerSession@ ps) {
	MapInstance@ mi = ctx.player_map(ps);
	WorldStructure@ st = builder_find_near(ctx, mi, ps.x, ps.y, ps.z, 2.7);
	if (@st == null) return;
	StructDef@ sdef = find_struct(st.type);
	if (@sdef == null) return;

	if (sdef.is_door) {
		if (st.locked && !builder_can_access(ctx, ps, st)) {
			ctx.broadcast_sfx_3d(mi.slug, "world", "builder/door_locked.ogg", st.x, st.y, st.z, 0.85, 18.0);
			ctx.send_speech(ps, MBUF_GAME, true, "Door is locked by " + st.owner + ".");
			return;
		}
		st.is_open = !st.is_open;
		ctx.sync_map_occluders(mi);
		ctx.objects_dirty = true;
		ctx.broadcast_obj("upd", st);
		ctx.broadcast_sfx_3d(mi.slug, "world", st.is_open ? "builder/door_open.ogg" : "builder/door_close.ogg", st.x, st.y, st.z, 0.9, 22.0);
		ctx.send_speech(ps, MBUF_GAME, false, st.is_open ? "Door opened." : "Door closed.");
		return;
	}
	if (sdef.is_chest) {
		if (st.locked && !builder_can_access(ctx, ps, st)) {
			ctx.broadcast_sfx_3d(mi.slug, "world", "builder/door_locked.ogg", st.x, st.y, st.z, 0.85, 18.0);
			ctx.send_speech(ps, MBUF_GAME, true, "Chest is locked by " + st.owner + ".");
			return;
		}
		ctx.broadcast_sfx_3d(mi.slug, "world", "builder/chest_open.ogg", st.x, st.y, st.z, 0.85, 16.0);
		ctx.send_control(ps, pkt_3("CHEST_DATA", "" + st.id, encode_chest_items(st.chest_items)));
		return;
	}
	if (sdef.is_campfire) {
		if (st.fuel_sec <= 0 && ps.count_item("wood") > 0) {
			ps.remove_item("wood", 1);
			st.fuel_sec = 240;
			ctx.objects_dirty = true;
			ctx.broadcast_obj("upd", st);
			ctx.broadcast_sfx_3d(mi.slug, "world", "survival/campfire_ignite.ogg", st.x, st.y, st.z, 0.9, 22.0);
			ctx.send_speech(ps, MBUF_GAME, false, "Relit campfire with 1 wood.");
			ctx.send_inv(ps);
		} else {
			ctx.send_speech(ps, MBUF_GAME, false, st.fuel_sec > 0 ? ("Campfire burning, " + st.fuel_sec + " seconds fuel left.") : "Campfire is out. Need 1 wood to relight.");
		}
		return;
	}
	if (sdef.is_bench) {
		ctx.send_speech(ps, MBUF_GAME, false, "Crafting bench owned by " + st.owner + ". Press C to craft advanced recipes.");
		return;
	}
	ctx.send_speech(ps, MBUF_GAME, false, sdef.name + " owned by " + st.owner + ", " + st.hp + " of " + st.max_hp + " health.");
}

void builder_toggle_lock(ServerCtx@ ctx, PlayerSession@ ps) {
	MapInstance@ mi = ctx.player_map(ps);
	WorldStructure@ st = builder_find_near(ctx, mi, ps.x, ps.y, ps.z, 2.8);
	if (@st == null) { ctx.send_speech(ps, MBUF_GAME, false, "No structure nearby."); return; }
	StructDef@ sdef = find_struct(st.type);
	if (@sdef == null || !sdef.lockable) { ctx.send_speech(ps, MBUF_GAME, false, "That structure cannot be locked."); return; }
	if (!builder_can_access(ctx, ps, st)) {
		ctx.send_speech(ps, MBUF_GAME, true, "Only the owner can lock or unlock this.");
		return;
	}
	st.locked = !st.locked;
	ctx.objects_dirty = true;
	ctx.broadcast_obj("upd", st);
	ctx.broadcast_sfx_3d(mi.slug, "world", "builder/door_locked.ogg", st.x, st.y, st.z, 0.8, 16.0);
	ctx.send_speech(ps, MBUF_GAME, false, sdef.name + (st.locked ? " locked." : " unlocked."));
}

void builder_repair(ServerCtx@ ctx, PlayerSession@ ps) {
	MapInstance@ mi = ctx.player_map(ps);
	WorldStructure@ st = builder_find_near(ctx, mi, ps.x, ps.y, ps.z, 2.8);
	if (@st == null) { ctx.send_speech(ps, MBUF_GAME, false, "No structure nearby to repair."); return; }
	if (st.hp >= st.max_hp) { ctx.send_speech(ps, MBUF_GAME, false, "Already at full durability."); return; }
	if (ps.count_item("wood") < 1) { ctx.send_speech(ps, MBUF_GAME, true, "Need 1 wood to repair."); return; }
	ps.remove_item("wood", 1);
	st.hp = clampi(st.hp + 50, 1, st.max_hp);
	ctx.objects_dirty = true;
	ctx.broadcast_obj("upd", st);
	ctx.broadcast_sfx_3d(mi.slug, "world", "builder/build_repair.ogg", st.x, st.y, st.z, 0.85, 18.0);
	ctx.send_speech(ps, MBUF_GAME, false, "Repaired to " + st.hp + " of " + st.max_hp + ".");
	ctx.send_inv(ps);
}

void builder_demolish(ServerCtx@ ctx, PlayerSession@ ps) {
	MapInstance@ mi = ctx.player_map(ps);
	WorldStructure@ st = builder_find_near(ctx, mi, ps.x, ps.y, ps.z, 2.8);
	if (@st == null) { ctx.send_speech(ps, MBUF_GAME, false, "No structure nearby to demolish."); return; }
	if (st.owner.lower() != ps.name.lower() && ps.rank < RANK_ADMIN) {
		ctx.send_speech(ps, MBUF_GAME, true, "You can only demolish your own structures.");
		return;
	}
	for (uint k = 0; k < ctx.structures.length(); k++) {
		if (@ctx.structures[k] == @st) { ctx.structures.remove_at(k); break; }
	}
	ctx.sync_map_occluders(mi);
	ctx.objects_dirty = true;
	ctx.broadcast_obj("del", st);
	ctx.broadcast_sfx_3d(mi.slug, "world", "builder/build_break.ogg", st.x, st.y, st.z, 0.9, 22.0);
	ctx.send_speech(ps, MBUF_GAME, false, "Demolished structure.");
}

void builder_handle_chest_op(ServerCtx@ ctx, PlayerSession@ ps, string[]@ p) {
	string op = field(p, 1, "");
	uint64 oid = uint64(parse_int(field(p, 2, "0")));
	int slot = safe_int(field(p, 3, "0"), 0, 50, 0);
	int qty = safe_int(field(p, 4, "1"), 1, 99, 1);

	MapInstance@ mi = ctx.player_map(ps);
	WorldStructure@ st = null;
	for (uint i = 0; i < ctx.structures.length(); i++) {
		if (ctx.structures[i].id == oid && ctx.struct_on_map(ctx.structures[i], mi)) { @st = @ctx.structures[i]; break; }
	}
	if (@st == null || get_3d_distance(ps.x, ps.y, ps.z, st.x, st.y, st.z) > 3.5) {
		ctx.send_speech(ps, MBUF_GAME, true, "Too far from chest.");
		return;
	}
	StructDef@ cdef = find_struct(st.type);
	if (@cdef == null || !cdef.is_chest) return;
	if (st.locked && !builder_can_access(ctx, ps, st)) {
		ctx.send_speech(ps, MBUF_GAME, true, "Chest is locked.");
		return;
	}
	if (op == "put" && slot < int(ps.inv.length())) {
		ItemStack@ it = ps.inv[uint(slot)];
		int take_q = it.qty < qty ? it.qty : qty;
		bool stacked = false;
		for (uint i = 0; i < st.chest_items.length(); i++) {
			if (st.chest_items[i].id == it.id) { st.chest_items[i].qty += take_q; stacked = true; break; }
		}
		if (!stacked) {
			if (st.chest_items.length() >= uint(MAX_CHEST_SLOTS)) { ctx.send_speech(ps, MBUF_GAME, true, "Chest is full."); return; }
			st.chest_items.insert_last(ItemStack(it.id, take_q));
		}
		ps.remove_item(it.id, take_q);
		ctx.objects_dirty = true;
		ctx.send_inv(ps);
		ctx.send_control(ps, pkt_3("CHEST_DATA", "" + st.id, encode_chest_items(st.chest_items)));
	} else if (op == "take" && slot < int(st.chest_items.length())) {
		ItemStack@ cit = st.chest_items[uint(slot)];
		int give_q = cit.qty < qty ? cit.qty : qty;
		if (!ps.add_item(cit.id, give_q)) { ctx.send_speech(ps, MBUF_GAME, true, "Inventory full."); return; }
		cit.qty -= give_q;
		if (cit.qty <= 0) st.chest_items.remove_at(uint(slot));
		ctx.objects_dirty = true;
		ctx.send_inv(ps);
		ctx.send_control(ps, pkt_3("CHEST_DATA", "" + st.id, encode_chest_items(st.chest_items)));
	}
}

// ------------------------------------------------------------------ STW AUDIO MAP BUILDER (MULTI-MAP & LINE MANAGER)

MapInstance@ builder_target_map(ServerCtx@ ctx, PlayerSession@ ps) {
	MapInstance@ mi = ctx.find_map(ps.builder_edit_map);
	if (@mi == null) @mi = ctx.player_map(ps);
	if (@mi != null) ps.builder_edit_map = mi.slug;
	return mi;
}

void builder_send_hub_sync(ServerCtx@ ctx, PlayerSession@ ps) {
	MapInstance@ ed = builder_target_map(ctx, ps);
	string sp_rows = "";
	for (uint i = 0; i < g_species.length(); i++) {
		SpeciesDef@ sp = g_species[i];
		if (sp_rows.length() > 0) sp_rows += ";";
		sp_rows += sp.kind + "~" + wire_escape(sp.name) + "~" + (sp.hostile ? "1" : "0");
	}
	if (sp_rows.length() == 0) sp_rows = "-";
	ctx.send_control(ps, pkt_build("BM_SPECIES", {sp_rows}));

	string rows = "";
	for (uint i = 0; i < ctx.maps.length(); i++) {
		MapInstance@ m = ctx.maps[i];
		if (rows.length() > 0) rows += ";";
		rows += wire_escape(m.slug) + ":" + wire_escape(m.map.name) + ":" + m.map.width + ":" + m.map.height
			+ ":" + m.map.min_z + ":" + m.map.max_z + ":" + m.map.default_surface + ":" + wire_escape(m.map.ambience_default)
			+ ":" + (m.map.pvp_enabled ? "1" : "0") + ":" + ctx.count_players_on_map(m.slug) + ":" + m.map.raw_lines.length()
			+ ":" + (m.map.allow_build ? "1" : "0") + ":" + (m.map.weather_enabled ? "1" : "0") + ":" + m.map.time_mode;
	}
	if (rows.length() == 0) rows = "-";
	ctx.send_control(ps, pkt_build("BM_MAPS", {@ed != null ? ed.slug : ctx.default_map_slug, rows}));
}

void builder_reload_map_clients(ServerCtx@ ctx, MapInstance@ mi) {
	if (@mi == null) return;
	ctx.sync_map_occluders(mi);
	world_init_nodes(ctx, mi);
	wildlife_sync_map_spawns(ctx, mi);
	for (uint i = 0; i < ctx.sessions.length(); i++) {
		PlayerSession@ p = ctx.sessions[i];
		if (!p.authed || p.peer_id == 0 || p.current_map.lower() != mi.slug.lower()) continue;
		ctx.send_map_sync(p);
		ctx.send_speech(p, MBUF_SYSTEM, false, "Map " + mi.map.name + " updated by builder.");
	}
}

bool builder_save_map_disk(ServerCtx@ ctx, MapInstance@ mi, string&out err) {
	err = "";
	if (@mi == null) { err = "No map selected."; return false; }
	string[]@ errs = mi.map.validate();
	if (errs.length() > 0) { err = errs[0]; return false; }
	if (!directory_exists(ctx.maps_dir)) directory_create(ctx.maps_dir);
	string out_path = mi.file_path.length() > 0 ? mi.file_path : (ctx.maps_dir + "/" + mi.slug + ".map");
	string tmp = out_path + ".tmp";
	string bak = out_path + ".bak";
	if (!file_put_contents(tmp, mi.map.serialize(), false)) { err = "Failed writing temp map file."; return false; }
	if (file_exists(out_path)) {
		file_copy(out_path, bak, true);
		file_delete(out_path);
	}
	if (!file_move(tmp, out_path)) {
		if (!file_copy(tmp, out_path, true)) { err = "Failed replacing map file."; return false; }
		file_delete(tmp);
	}
	mi.file_path = out_path;
	return true;
}

void send_builder_pos(ServerCtx@ ctx, PlayerSession@ ps) {
	MapInstance@ mi = builder_target_map(ctx, ps);
	if (@mi == null) return;
	string surf = mi.map.surface_at(double(ps.builder_cx) + 0.5, double(ps.builder_cy) + 0.5, double(ps.builder_cz));
	string zname = mi.map.zone_name_at(double(ps.builder_cx) + 0.5, double(ps.builder_cy) + 0.5, double(ps.builder_cz));
	string mat;
	bool has_wall = mi.map.blocked_by_wall(double(ps.builder_cx) + 0.5, double(ps.builder_cy) + 0.5, double(ps.builder_cz), 0.25, mat);
	ctx.send_control(ps, pkt_build("BUILDER_POS", {"" + ps.builder_cx, "" + ps.builder_cy, "" + ps.builder_cz, surf, wire_escape(zname), has_wall ? mat : "-"}));
}

string build_box_line_from_cmd(string kind, string[]@ p, uint off, int map_w, int map_h, int map_min_z, int map_max_z, string&out err) {
	err = "";
	if (kind == "floor" || kind == "stairs" || kind == "ramp") {
		string lbl = wire_unescape(field(p, off, kind));
		double x1 = safe_double(field(p, off + 1, "0"), 0.0, double(map_w), 0.0);
		double x2 = safe_double(field(p, off + 2, "10"), 0.0, double(map_w), 10.0);
		double y1 = safe_double(field(p, off + 3, "0"), 0.0, double(map_h), 0.0);
		double y2 = safe_double(field(p, off + 4, "10"), 0.0, double(map_h), 10.0);
		double z1 = safe_double(field(p, off + 5, "0"), double(MAP_MIN_Z), double(MAP_MAX_Z), 0.0);
		double z2 = safe_double(field(p, off + 6, kind == "stairs" ? "10" : "0"), double(MAP_MIN_Z), double(MAP_MAX_Z), 0.0);
		order_pair(x1, x2); order_pair(y1, y2); order_pair(z1, z2);
		string surf = field(p, off + 7, "wood");
		bool roof = field(p, off + 8, "0") == "1";
		string axis = field(p, off + 9, "y");
		int dir = safe_int(field(p, off + 10, "1"), -1, 1, 1);
		return make_p_line(lbl, x1, y1, x2, y2, z1, z2, surf, kind, roof, axis, dir);
	}
	if (kind == "wall") {
		string lbl = wire_unescape(field(p, off, "Wall"));
		double x1 = safe_double(field(p, off + 1, "0"), 0.0, double(map_w), 0.0);
		double x2 = safe_double(field(p, off + 2, "5"), 0.0, double(map_w), 5.0);
		double y1 = safe_double(field(p, off + 3, "0"), 0.0, double(map_h), 0.0);
		double y2 = safe_double(field(p, off + 4, "1"), 0.0, double(map_h), 1.0);
		double z1 = safe_double(field(p, off + 5, "0"), double(MAP_MIN_Z), double(MAP_MAX_Z), 0.0);
		double z2 = safe_double(field(p, off + 6, "4"), double(MAP_MIN_Z), double(MAP_MAX_Z), 4.0);
		order_pair(x1, x2); order_pair(y1, y2); order_pair(z1, z2);
		string mat = field(p, off + 7, "wood");
		bool occ = field(p, off + 8, "1") == "1";
		return make_w_line(lbl, x1, y1, x2, y2, z1, z2, mat, occ);
	}
	if (kind == "zone") {
		string lbl = wire_unescape(field(p, off, "Zone"));
		double x1 = safe_double(field(p, off + 1, "0"), 0.0, double(map_w), 0.0);
		double x2 = safe_double(field(p, off + 2, "20"), 0.0, double(map_w), 20.0);
		double y1 = safe_double(field(p, off + 3, "0"), 0.0, double(map_h), 0.0);
		double y2 = safe_double(field(p, off + 4, "20"), 0.0, double(map_h), 20.0);
		double z1 = safe_double(field(p, off + 5, "" + map_min_z), double(MAP_MIN_Z), double(MAP_MAX_Z), double(map_min_z));
		double z2 = safe_double(field(p, off + 6, "" + map_max_z), double(MAP_MIN_Z), double(MAP_MAX_Z), double(map_max_z));
		order_pair(x1, x2); order_pair(y1, y2); order_pair(z1, z2);
		string surf = field(p, off + 7, "grass");
		string amb = field(p, off + 8, "");
		bool safe = field(p, off + 9, "0") == "1";
		string rev = normalize_reverb_preset(field(p, off + 10, "none"));
		return make_z_line(lbl, x1, y1, x2, y2, z1, z2, surf, amb, safe, rev);
	}
	if (kind == "animal_spawn") {
		string lbl = wire_unescape(field(p, off, "Wildlife Spawn"));
		double x1 = safe_double(field(p, off + 1, "0"), 0.0, double(map_w), 0.0);
		double x2 = safe_double(field(p, off + 2, "20"), 0.0, double(map_w), 20.0);
		double y1 = safe_double(field(p, off + 3, "0"), 0.0, double(map_h), 0.0);
		double y2 = safe_double(field(p, off + 4, "20"), 0.0, double(map_h), 20.0);
		double z1 = safe_double(field(p, off + 5, "0"), double(MAP_MIN_Z), double(MAP_MAX_Z), 0.0);
		double z2 = safe_double(field(p, off + 6, "5"), double(MAP_MIN_Z), double(MAP_MAX_Z), 5.0);
		order_pair(x1, x2); order_pair(y1, y2); order_pair(z1, z2);
		int iv_ms = safe_int(field(p, off + 7, "5000"), 250, 3600000, 5000);
		int qty = safe_int(field(p, off + 8, "3"), 1, 50, 3);
		string[]@ parsed_sp = parse_species_csv(field(p, off + 9, ""));
		string[] valid_sp;
		for (uint si = 0; si < parsed_sp.length(); si++) {
			if (@find_species(parsed_sp[si]) != null) valid_sp.insert_last(parsed_sp[si]);
		}
		if (valid_sp.length() == 0) {
			err = "Select at least 1 valid animal species.";
			return "";
		}
		bool leash = field(p, off + 10, "1") == "1";
		string act_time = normalize_active_time(field(p, off + 11, "always"));
		return make_e_line(lbl, x1, y1, x2, y2, z1, z2, iv_ms, qty, join_species_csv(valid_sp), leash, act_time);
	}
	if (kind == "water") {
		string lbl = wire_unescape(field(p, off, "Water"));
		double x1 = safe_double(field(p, off + 1, "0"), 0.0, double(map_w), 0.0);
		double x2 = safe_double(field(p, off + 2, "10"), 0.0, double(map_w), 10.0);
		double y1 = safe_double(field(p, off + 3, "0"), 0.0, double(map_h), 0.0);
		double y2 = safe_double(field(p, off + 4, "10"), 0.0, double(map_h), 10.0);
		double z1 = safe_double(field(p, off + 5, "-2"), double(MAP_MIN_Z), double(MAP_MAX_Z), -2.0);
		double z2 = safe_double(field(p, off + 6, "0"), double(MAP_MIN_Z), double(MAP_MAX_Z), 0.0);
		order_pair(x1, x2); order_pair(y1, y2); order_pair(z1, z2);
		string depth = field(p, off + 7, "shallow");
		string snd = field(p, off + 8, "ambience/river_loop.ogg");
		return make_l_line(lbl, x1, y1, x2, y2, z1, z2, depth, snd);
	}
	if (kind == "hazard") {
		string lbl = wire_unescape(field(p, off, "Hazard"));
		double x1 = safe_double(field(p, off + 1, "0"), 0.0, double(map_w), 0.0);
		double x2 = safe_double(field(p, off + 2, "4"), 0.0, double(map_w), 4.0);
		double y1 = safe_double(field(p, off + 3, "0"), 0.0, double(map_h), 0.0);
		double y2 = safe_double(field(p, off + 4, "4"), 0.0, double(map_h), 4.0);
		double z1 = safe_double(field(p, off + 5, "0"), double(MAP_MIN_Z), double(MAP_MAX_Z), 0.0);
		double z2 = safe_double(field(p, off + 6, "2"), double(MAP_MIN_Z), double(MAP_MAX_Z), 2.0);
		order_pair(x1, x2); order_pair(y1, y2); order_pair(z1, z2);
		int dmg = safe_int(field(p, off + 7, "15"), 1, 100, 15);
		int iv = safe_int(field(p, off + 8, "1200"), 250, 10000, 1200);
		string snd = field(p, off + 9, "world/hazard_hit.ogg");
		return make_h_line(lbl, x1, y1, x2, y2, z1, z2, dmg, iv, snd);
	}
	if (kind == "portal") {
		string lbl = wire_unescape(field(p, off, "Portal"));
		double x1 = safe_double(field(p, off + 1, "0"), 0.0, double(map_w), 0.0);
		double x2 = safe_double(field(p, off + 2, "3"), 0.0, double(map_w), 3.0);
		double y1 = safe_double(field(p, off + 3, "0"), 0.0, double(map_h), 0.0);
		double y2 = safe_double(field(p, off + 4, "3"), 0.0, double(map_h), 3.0);
		double z1 = safe_double(field(p, off + 5, "0"), double(MAP_MIN_Z), double(MAP_MAX_Z), 0.0);
		double z2 = safe_double(field(p, off + 6, "3"), double(MAP_MIN_Z), double(MAP_MAX_Z), 3.0);
		order_pair(x1, x2); order_pair(y1, y2); order_pair(z1, z2);
		string tmap = slugify_map_id(field(p, off + 7, "wildlands_valley"));
		double dx = safe_double(field(p, off + 8, "10"), 1.0, 500.0, 10.0);
		double dy = safe_double(field(p, off + 9, "10"), 1.0, 500.0, 10.0);
		double dz = safe_double(field(p, off + 10, "0"), double(MAP_MIN_Z), double(MAP_MAX_Z), 0.0);
		int dfac = wrap_deg(safe_int(field(p, off + 11, "0"), 0, 359, 0));
		bool auto_st = field(p, off + 12, "0") == "1";
		string snd = field(p, off + 13, "world/portal_travel.ogg");
		return make_d_line(lbl, x1, y1, x2, y2, z1, z2, tmap, dx, dy, dz, dfac, auto_st, snd);
	}
	if (kind == "resource") {
		string rtype = field(p, off, "tree");
		double rx = safe_double(field(p, off + 1, "10"), 1.0, double(map_w - 1), 10.0);
		double ry = safe_double(field(p, off + 2, "10"), 1.0, double(map_h - 1), 10.0);
		double rz = safe_double(field(p, off + 3, "0"), double(MAP_MIN_Z), double(MAP_MAX_Z), 0.0);
		int chg = safe_int(field(p, off + 4, "4"), 1, 20, 4);
		int rsec = safe_int(field(p, off + 5, "45"), 5, 3600, 45);
		return make_r_line(rtype, rx, ry, rz, chg, rsec);
	}
	if (kind == "emitter") {
		string lbl = wire_unescape(field(p, off, "Landmark"));
		string snd = field(p, off + 1, "builder/beacon_ping.ogg");
		double ex = safe_double(field(p, off + 2, "10"), 1.0, double(map_w - 1), 10.0);
		double ey = safe_double(field(p, off + 3, "10"), 1.0, double(map_h - 1), 10.0);
		double ez = safe_double(field(p, off + 4, "0"), double(MAP_MIN_Z), double(MAP_MAX_Z), 0.0);
		int rng = safe_int(field(p, off + 5, "24"), 2, 100, 24);
		double vol = safe_double(field(p, off + 6, "0.65"), 0.05, 1.0, 0.65);
		return make_a_line(lbl, snd, ex, ey, ez, rng, vol);
	}
	if (kind == "spawn") {
		string lbl = wire_unescape(field(p, off, "Spawn"));
		double sx = safe_double(field(p, off + 1, "10"), 1.0, double(map_w - 1), 10.0);
		double sy = safe_double(field(p, off + 2, "10"), 1.0, double(map_h - 1), 10.0);
		double sz = safe_double(field(p, off + 3, "0"), double(MAP_MIN_Z), double(MAP_MAX_Z), 0.0);
		int fac = wrap_deg(safe_int(field(p, off + 4, "0"), 0, 359, 0));
		return make_s_line(lbl, sx, sy, sz, fac);
	}
	err = "Unknown element kind: " + kind;
	return "";
}

void builder_send_lm_list(ServerCtx@ ctx, PlayerSession@ ps, MapInstance@ mi, const string&in filter) {
	if (@mi == null) return;
	string flt = filter.trim_whitespace().upper();
	string[] rows;
	for (uint i = 0; i < mi.map.raw_lines.length(); i++) {
		string ln = mi.map.raw_lines[i];
		string[]@ tok = split_keep_empty(ln, FIELD_SEP);
		string tag = field(tok, 0, "");
		if (flt.length() > 0 && flt != "ALL") {
			if (flt == "STAIRS") {
				if (tag != "P" || ln.find("|stairs|") < 0) continue;
			} else if (flt == "FLOOR") {
				if (tag != "P" || ln.find("|stairs|") >= 0) continue;
			} else if (tag != flt) {
				continue;
			}
		}
		rows.insert_last("" + i + "~" + tag + "~" + wire_escape(mi.map.line_summary(i)) + "~" + wire_escape(ln));
	}

	// Batch lines into chunks <= 1050 bytes each.
	string[] chunks;
	string cur = "";
	for (uint i = 0; i < rows.length(); i++) {
		if (cur.length() > 0 && cur.length() + rows[i].length() + 1 > 1050) {
			chunks.insert_last(cur);
			cur = "";
		}
		if (cur.length() > 0) cur += "\n";
		cur += rows[i];
	}
	if (cur.length() > 0 || chunks.length() == 0) chunks.insert_last(cur);

	ctx.send_control(ps, pkt_build("BM_LM_HDR", {mi.slug, "" + rows.length(), "" + chunks.length()}));
	for (uint i = 0; i < chunks.length(); i++) {
		ctx.send_control(ps, pkt_build("BM_LM_CHK", {"" + i, chunks[i].length() > 0 ? wire_escape(chunks[i]) : "-"}));
	}
}

void builder_handle_map_cmd(ServerCtx@ ctx, PlayerSession@ ps, string[]@ p) {
	if (@ps == null || !ps.authed) return;
	if (ps.rank < RANK_BUILDER) {
		ctx.send_speech(ps, MBUF_SYSTEM, true, "Builder rank or higher is required for Map Builder.");
		ctx.logger.log("REFUSED", "BUILDMAP denied for " + ps.name + " (rank " + ps.rank + ")");
		return;
	}
	string cmd = field(p, 1, "");
	MapInstance@ mi = builder_target_map(ctx, ps);

	if (cmd == "hub_sync") {
		builder_send_hub_sync(ctx, ps);
		return;
	}
	if (cmd == "noclip") {
		ps.builder_noclip = field(p, 2, "0") == "1";
		if (ps.builder_noclip) ps.builder_mode = false;
		ctx.send_speech(ps, MBUF_GAME, true, ps.builder_noclip ? "Builder noclip flight enabled." : "Builder noclip flight disabled.");
		return;
	}
	if (cmd == "toggle") {
		ps.builder_mode = !ps.builder_mode;
		if (ps.builder_mode) ps.builder_noclip = false;
		if (@mi != null) {
			ps.builder_cx = clampi(int(ps.x), 1, mi.map.width - 1);
			ps.builder_cy = clampi(int(ps.y), 1, mi.map.height - 1);
			ps.builder_cz = clampi(int(ps.z), mi.map.min_z, mi.map.max_z);
		}
		ps.builder_has_mark = false;
		ctx.send_speech(ps, MBUF_GAME, true, ps.builder_mode ? "Entered Audio Map Builder mode." : "Exited Map Builder mode.");
		if (ps.builder_mode) send_builder_pos(ctx, ps);
		return;
	}
	if (cmd == "step" && @mi != null) {
		int dx = safe_int(field(p, 2, "0"), -10, 10, 0);
		int dy = safe_int(field(p, 3, "0"), -10, 10, 0);
		int dz = safe_int(field(p, 4, "0"), -5, 5, 0);
		ps.builder_cx = clampi(ps.builder_cx + dx, 0, mi.map.width - 1);
		ps.builder_cy = clampi(ps.builder_cy + dy, 0, mi.map.height - 1);
		ps.builder_cz = clampi(ps.builder_cz + dz, mi.map.min_z, mi.map.max_z);
		send_builder_pos(ctx, ps);
		return;
	}
	if (cmd == "mark") {
		ps.builder_has_mark = true;
		ps.builder_mx = ps.builder_cx;
		ps.builder_my = ps.builder_cy;
		ps.builder_mz = ps.builder_cz;
		ctx.send_speech(ps, MBUF_GAME, true, "Corner 1 marked at " + ps.builder_mx + ", " + ps.builder_my + ", height " + ps.builder_mz + ".");
		return;
	}

	if (cmd == "create_map") {
		string raw_slug = field(p, 2, "");
		string slug = slugify_map_id(raw_slug);
		string dname = strip_control_chars(wire_unescape(field(p, 3, "New Map")), 40);
		if (dname.length() < 2) dname = slug;
		if (@ctx.find_map(slug) != null) {
			ctx.send_control(ps, pkt_3("BM_RES", "err", wire_escape("A map named " + slug + " already exists.")));
			return;
		}
		int w = safe_int(field(p, 4, "100"), 40, 500, 100);
		int h = safe_int(field(p, 5, "100"), 40, 500, 100);
		int min_z = safe_int(field(p, 6, "-20"), MAP_MIN_Z, 0, -20);
		int max_z = safe_int(field(p, 7, "30"), 5, MAP_MAX_Z, 30);
		if (min_z > max_z) { int t = min_z; min_z = max_z; max_z = t; }
		string surf = field(p, 8, "grass");
		string tmpl = field(p, 9, "flat").trim_whitespace().lower();
		if (tmpl != "flat" && tmpl != "void" && tmpl != "arena" && tmpl != "cave") tmpl = "flat";
		double sx = clampd(safe_double(field(p, 10, "" + (w / 2)), 2.0, double(w - 2), double(w / 2)), 2.0, double(w - 2));
		double sy = clampd(safe_double(field(p, 11, "" + (h / 2)), 2.0, double(h - 2), double(h / 2)), 2.0, double(h - 2));
		double sz = safe_double(field(p, 12, "0"), double(min_z), double(max_z), 0.0);

		string raw_map = generate_map_template_raw(tmpl, dname, w, h, min_z, max_z, surf, sx, sy, sz);

		MapInstance nmi;
		nmi.slug = slug;
		nmi.file_path = ctx.maps_dir + "/" + slug + ".map";
		nmi.map.slug = slug;
		string err;
		if (!nmi.map.load_from_string(raw_map, err)) {
			ctx.send_control(ps, pkt_3("BM_RES", "err", wire_escape("Map validation error: " + err)));
			return;
		}
		if (!builder_save_map_disk(ctx, nmi, err)) {
			ctx.send_control(ps, pkt_3("BM_RES", "err", wire_escape(err)));
			return;
		}
		ctx.maps.insert_last(nmi);
		world_init_nodes(ctx, nmi);
		wildlife_sync_map_spawns(ctx, nmi);
		ps.builder_edit_map = nmi.slug;
		ctx.logger.log("BUILDER", ps.name + " created new map '" + nmi.slug + "' (" + tmpl + ", " + w + "x" + h + ")");
		ctx.send_sfx_to(ps, "self", "builder/map_create.ogg", ps.x, ps.y, ps.z, 0.85);
		builder_send_hub_sync(ctx, ps);
		ctx.send_control(ps, pkt_3("BM_RES", "ok", wire_escape("Created map " + dname + " (" + slug + ").")));
		return;
	}

	if (cmd == "select_map") {
		string slug = field(p, 2, "");
		MapInstance@ target = ctx.find_map(slug);
		if (@target == null) {
			ctx.send_control(ps, pkt_3("BM_RES", "err", wire_escape("Map not found: " + slug)));
			return;
		}
		ps.builder_edit_map = target.slug;
		builder_send_hub_sync(ctx, ps);
		ctx.send_control(ps, pkt_3("BM_RES", "ok", wire_escape("Active builder map set to " + target.map.name + " (edit only).")));
		return;
	}

	if (cmd == "clone_map") {
		string src_slug = field(p, 2, ps.builder_edit_map);
		MapInstance@ src = ctx.find_map(src_slug);
		if (@src == null) {
			ctx.send_control(ps, pkt_3("BM_RES", "err", wire_escape("Source map not found: " + src_slug)));
			return;
		}
		string new_slug = slugify_map_id(field(p, 3, src.slug + "_copy"));
		if (@ctx.find_map(new_slug) != null) {
			ctx.send_control(ps, pkt_3("BM_RES", "err", wire_escape("A map named " + new_slug + " already exists.")));
			return;
		}
		string new_name = strip_control_chars(wire_unescape(field(p, 4, src.map.name + " Copy")), 40);
		if (new_name.length() < 2) new_name = new_slug;

		MapInstance cmi;
		cmi.slug = new_slug;
		cmi.file_path = ctx.maps_dir + "/" + new_slug + ".map";
		cmi.map.slug = new_slug;
		string err;
		if (!cmi.map.load_from_string(src.map.serialize(), err)) {
			ctx.send_control(ps, pkt_3("BM_RES", "err", wire_escape("Clone load error: " + err)));
			return;
		}
		cmi.map.lm_replace_line(0, make_m_line(new_name, cmi.map.width, cmi.map.height, cmi.map.min_z, cmi.map.max_z, cmi.map.default_surface, cmi.map.ambience_default, cmi.map.pvp_enabled, cmi.map.allow_build, cmi.map.weather_enabled, cmi.map.time_mode), err);
		if (!builder_save_map_disk(ctx, cmi, err)) {
			ctx.send_control(ps, pkt_3("BM_RES", "err", wire_escape(err)));
			return;
		}
		ctx.maps.insert_last(cmi);
		world_init_nodes(ctx, cmi);
		wildlife_sync_map_spawns(ctx, cmi);
		ps.builder_edit_map = cmi.slug;
		ctx.logger.log("BUILDER", ps.name + " cloned '" + src.slug + "' -> '" + cmi.slug + "'");
		ctx.send_sfx_to(ps, "self", "builder/map_create.ogg", ps.x, ps.y, ps.z, 0.85);
		builder_send_hub_sync(ctx, ps);
		ctx.send_control(ps, pkt_3("BM_RES", "ok", wire_escape("Cloned map to " + new_name + " (" + cmi.slug + ").")));
		return;
	}

	if (cmd == "edit_header" && @mi != null) {
		string dname = strip_control_chars(wire_unescape(field(p, 2, mi.map.name)), 40);
		int w = safe_int(field(p, 3, "" + mi.map.width), 40, 500, mi.map.width);
		int h = safe_int(field(p, 4, "" + mi.map.height), 40, 500, mi.map.height);
		int min_z = safe_int(field(p, 5, "" + mi.map.min_z), MAP_MIN_Z, 0, mi.map.min_z);
		int max_z = safe_int(field(p, 6, "" + mi.map.max_z), 5, MAP_MAX_Z, mi.map.max_z);
		if (min_z > max_z) { int t = min_z; min_z = max_z; max_z = t; }
		string surf = field(p, 7, mi.map.default_surface);
		string amb = normalize_amb_ref(field(p, 8, mi.map.ambience_default));
		bool pvp = field(p, 9, "1") == "1";
		bool abuild = field(p, 10, mi.map.allow_build ? "1" : "0") == "1";
		bool weath = field(p, 11, mi.map.weather_enabled ? "1" : "0") == "1";
		string tmode = normalize_time_mode(field(p, 12, mi.map.time_mode));
		mi.push_undo();
		string err;
		if (!mi.map.lm_replace_line(0, make_m_line(dname, w, h, min_z, max_z, surf, amb, pvp, abuild, weath, tmode), err)) {
			ctx.send_control(ps, pkt_3("BM_RES", "err", wire_escape(err)));
			return;
		}
		builder_reload_map_clients(ctx, mi);
		builder_send_hub_sync(ctx, ps);
		ctx.send_control(ps, pkt_3("BM_RES", "ok", wire_escape("Updated map header for " + dname + ".")));
		return;
	}

	if (cmd == "delete_map") {
		string slug = field(p, 2, "");
		if (ctx.maps.length() <= 1 || slug.lower() == ctx.default_map_slug.lower()) {
			ctx.send_control(ps, pkt_3("BM_RES", "err", wire_escape("Cannot delete the primary default map.")));
			return;
		}
		MapInstance@ dm = ctx.find_map(slug);
		if (@dm == null) { ctx.send_control(ps, pkt_3("BM_RES", "err", wire_escape("Map not found."))); return; }
		MapInstance@ defm = ctx.default_map();
		for (uint i = 0; i < ctx.sessions.length(); i++) {
			PlayerSession@ op = ctx.sessions[i];
			if (op.authed && op.peer_id != 0 && op.current_map.lower() == dm.slug.lower() && @defm != null) {
				MapSpawn@ sp = defm.map.spawns[0];
				world_transfer_player_map(ctx, op, defm, sp.x, sp.y, sp.z, sp.facing);
			}
		}
		if (file_exists(dm.file_path)) {
			file_copy(dm.file_path, dm.file_path + ".deleted.bak", true);
			file_delete(dm.file_path);
		}
		for (uint i = 0; i < ctx.maps.length(); i++) {
			if (@ctx.maps[i] == @dm) { ctx.maps.remove_at(i); break; }
		}
		if (ps.builder_edit_map.lower() == slug.lower() && @defm != null) ps.builder_edit_map = defm.slug;
		ctx.logger.log("BUILDER", ps.name + " deleted map " + slug);
		builder_send_hub_sync(ctx, ps);
		ctx.send_control(ps, pkt_3("BM_RES", "ok", wire_escape("Deleted map " + slug + ".")));
		return;
	}

	if (@mi == null) return;

	if (cmd == "add_box") {
		string kind = field(p, 2, "");
		string err;
		string line = build_box_line_from_cmd(kind, p, 3, mi.map.width, mi.map.height, mi.map.min_z, mi.map.max_z, err);
		if (line.length() == 0) {
			ctx.send_control(ps, pkt_3("BM_RES", "err", wire_escape(err)));
			return;
		}
		mi.push_undo();
		if (!mi.map.lm_append_line(line, err)) {
			ctx.send_control(ps, pkt_3("BM_RES", "err", wire_escape(err)));
			return;
		}
		builder_reload_map_clients(ctx, mi);
		ctx.send_sfx_to(ps, "self", "builder/line_add.ogg", ps.x, ps.y, ps.z, 0.8);
		ctx.logger.log("BUILDER", ps.name + " added " + kind + " to " + mi.slug);
		ctx.send_control(ps, pkt_3("BM_RES", "ok", wire_escape("Added " + kind + " to " + mi.map.name + ".")));
		return;
	}

	if (cmd == "lm_list") {
		builder_send_lm_list(ctx, ps, mi, field(p, 2, "ALL"));
		return;
	}
	if (cmd == "lm_raw_edit") {
		uint idx = uint(safe_int(field(p, 2, "-1"), 0, 5000, 0));
		string raw_line = strip_control_chars(wire_unescape(field(p, 3, "")), 300);
		mi.push_undo();
		string err;
		if (!mi.map.lm_replace_line(idx, raw_line, err)) {
			ctx.send_control(ps, pkt_3("BM_RES", "err", wire_escape("Line error: " + err)));
			return;
		}
		builder_reload_map_clients(ctx, mi);
		ctx.send_sfx_to(ps, "self", "builder/line_edit.ogg", ps.x, ps.y, ps.z, 0.8);
		ctx.send_control(ps, pkt_3("BM_RES", "ok", wire_escape("Updated line " + (idx + 1) + ".")));
		return;
	}
	if (cmd == "lm_replace_box") {
		uint idx = uint(safe_int(field(p, 2, "-1"), 0, 5000, 0));
		string kind = field(p, 3, "");
		string err;
		string line = build_box_line_from_cmd(kind, p, 4, mi.map.width, mi.map.height, mi.map.min_z, mi.map.max_z, err);
		if (line.length() == 0) {
			ctx.send_control(ps, pkt_3("BM_RES", "err", wire_escape(err)));
			return;
		}
		mi.push_undo();
		if (!mi.map.lm_replace_line(idx, line, err)) {
			ctx.send_control(ps, pkt_3("BM_RES", "err", wire_escape(err)));
			return;
		}
		builder_reload_map_clients(ctx, mi);
		ctx.send_sfx_to(ps, "self", "builder/line_edit.ogg", ps.x, ps.y, ps.z, 0.8);
		ctx.send_control(ps, pkt_3("BM_RES", "ok", wire_escape("Edited line " + (idx + 1) + ".")));
		return;
	}
	if (cmd == "lm_insert") {
		int after_idx = safe_int(field(p, 2, "0"), -1, 5000, 0);
		string raw_line = strip_control_chars(wire_unescape(field(p, 3, "")), 300);
		mi.push_undo();
		string err;
		if (!mi.map.lm_insert_line(after_idx, raw_line, err)) {
			ctx.send_control(ps, pkt_3("BM_RES", "err", wire_escape("Insert failed: " + err)));
			return;
		}
		builder_reload_map_clients(ctx, mi);
		ctx.send_sfx_to(ps, "self", "builder/line_add.ogg", ps.x, ps.y, ps.z, 0.8);
		ctx.send_control(ps, pkt_3("BM_RES", "ok", wire_escape("Inserted line.")));
		return;
	}
	if (cmd == "lm_dup") {
		uint idx = uint(safe_int(field(p, 2, "0"), 0, 5000, 0));
		mi.push_undo();
		string err;
		if (!mi.map.lm_duplicate_line(idx, err)) {
			ctx.send_control(ps, pkt_3("BM_RES", "err", wire_escape(err)));
			return;
		}
		builder_reload_map_clients(ctx, mi);
		ctx.send_sfx_to(ps, "self", "builder/line_add.ogg", ps.x, ps.y, ps.z, 0.8);
		ctx.send_control(ps, pkt_3("BM_RES", "ok", wire_escape("Duplicated line " + (idx + 1) + ".")));
		return;
	}
	if (cmd == "lm_move") {
		uint idx = uint(safe_int(field(p, 2, "0"), 0, 5000, 0));
		int delta = safe_int(field(p, 3, "1"), -1, 1, 1);
		mi.push_undo();
		string err;
		if (!mi.map.lm_move_line(idx, delta, err)) {
			ctx.send_control(ps, pkt_3("BM_RES", "err", wire_escape(err)));
			return;
		}
		builder_reload_map_clients(ctx, mi);
		ctx.send_sfx_to(ps, "self", "builder/line_edit.ogg", ps.x, ps.y, ps.z, 0.75);
		ctx.send_control(ps, pkt_3("BM_RES", "ok", wire_escape("Moved line " + (idx + 1) + ".")));
		return;
	}
	if (cmd == "lm_del") {
		uint idx = uint(safe_int(field(p, 2, "0"), 0, 5000, 0));
		mi.push_undo();
		string err;
		if (!mi.map.lm_delete_line(idx, err)) {
			ctx.send_control(ps, pkt_3("BM_RES", "err", wire_escape(err)));
			return;
		}
		builder_reload_map_clients(ctx, mi);
		ctx.send_sfx_to(ps, "self", "builder/line_delete.ogg", ps.x, ps.y, ps.z, 0.8);
		ctx.send_control(ps, pkt_3("BM_RES", "ok", wire_escape("Deleted line " + (idx + 1) + ".")));
		return;
	}
	if (cmd == "lm_tp") {
		if (mi.slug.lower() != ps.current_map.lower()) {
			ctx.send_control(ps, pkt_3("BM_RES", "err", wire_escape("You are editing " + mi.map.name + " from another map. Use /maps to travel there first.")));
			return;
		}
		uint idx = uint(safe_int(field(p, 2, "0"), 0, 5000, 0));
		double ax, ay, az;
		mi.map.line_anchor_pos(idx, ax, ay, az);
		world_transfer_player_map(ctx, ps, mi, ax, ay, az, ps.facing);
		return;
	}
	if (cmd == "undo") {
		if (mi.undo_history.length() == 0) {
			ctx.send_control(ps, pkt_3("BM_RES", "err", wire_escape("Nothing to undo on " + mi.map.name + ".")));
			return;
		}
		string[]@ prev = mi.undo_history[mi.undo_history.length() - 1];
		mi.undo_history.remove_at(mi.undo_history.length() - 1);
		string err;
		if (mi.map.lm_apply_lines(prev, err)) {
			builder_reload_map_clients(ctx, mi);
			ctx.send_control(ps, pkt_3("BM_RES", "ok", wire_escape("Undid last map change on " + mi.map.name + ".")));
		} else {
			ctx.send_control(ps, pkt_3("BM_RES", "err", wire_escape("Undo failed: " + err)));
		}
		return;
	}
	if (cmd == "validate") {
		string[]@ errs = mi.map.validate();
		if (errs.length() > 0) {
			ctx.send_control(ps, pkt_3("BM_RES", "err", wire_escape(errs[0])));
		} else {
			ctx.send_control(ps, pkt_3("BM_RES", "ok", wire_escape("Map " + mi.map.name + " validated with 0 errors and " + mi.map.raw_lines.length() + " lines.")));
		}
		return;
	}

	if (cmd == "save") {
		string err;
		if (!builder_save_map_disk(ctx, mi, err)) {
			ctx.send_control(ps, pkt_3("BM_RES", "err", wire_escape(err)));
			return;
		}
		ctx.logger.log("BUILDER", ps.name + " saved map " + mi.slug + " (" + mi.map.raw_lines.length() + " lines)");
		ctx.send_control(ps, pkt_3("BM_RES", "ok", wire_escape("Saved and backed up map " + mi.map.name + ".")));
		return;
	}
	if (cmd == "reload") {
		string err;
		WorldMap reloaded;
		if (!reloaded.load_from_file(mi.file_path, err)) {
			ctx.send_control(ps, pkt_3("BM_RES", "err", wire_escape("Reload failed: " + err)));
			return;
		}
		reloaded.slug = mi.slug;
		mi.map = reloaded;
		builder_reload_map_clients(ctx, mi);
		ctx.logger.log("BUILDER", ps.name + " reloaded map " + mi.slug);
		ctx.send_control(ps, pkt_3("BM_RES", "ok", wire_escape("Reloaded map " + mi.map.name + " live.")));
		return;
	}

	// Legacy quick cursor actions (when using Free-Roam Cursor mode)
	double x1 = double(ps.builder_has_mark ? (ps.builder_mx < ps.builder_cx ? ps.builder_mx : ps.builder_cx) : ps.builder_cx);
	double y1 = double(ps.builder_has_mark ? (ps.builder_my < ps.builder_cy ? ps.builder_my : ps.builder_cy) : ps.builder_cy);
	double x2 = double(ps.builder_has_mark ? (ps.builder_mx > ps.builder_cx ? ps.builder_mx : ps.builder_cx) : ps.builder_cx) + 1.0;
	double y2 = double(ps.builder_has_mark ? (ps.builder_my > ps.builder_cy ? ps.builder_my : ps.builder_cy) : ps.builder_cy) + 1.0;
	double cz = double(ps.builder_cz);
	string quick_line = "";
	if (cmd == "zone") quick_line = make_z_line(wire_unescape(field(p, 2, "Zone")), x1, y1, x2, y2, double(mi.map.min_z), double(mi.map.max_z), field(p, 3, "grass"), field(p, 4, "ambience/forest_day.ogg"), safe_int(field(p, 5, "0"), 0, 1, 0) == 1);
	else if (cmd == "wall") quick_line = make_w_line(wire_unescape(field(p, 2, "Wall")), x1, y1, x2, y2, cz, cz + double(safe_int(field(p, 4, "4"), 1, 30, 4)), field(p, 3, "wood"), true);
	else if (cmd == "platform") quick_line = make_p_line(wire_unescape(field(p, 2, "Platform")), x1, y1, x2, y2, cz, cz, field(p, 3, "wood"), safe_int(field(p, 4, "0"), 0, 1, 0) == 1 ? "ramp" : "floor", false, field(p, 5, "y"), safe_int(field(p, 6, "1"), -1, 1, 1));
	else if (cmd == "water") quick_line = make_l_line(wire_unescape(field(p, 2, "Water")), x1, y1, x2, y2, cz - 2.0, cz, field(p, 3, "shallow"), "ambience/river_loop.ogg");
	else if (cmd == "resource") quick_line = make_r_line(field(p, 2, "tree"), double(ps.builder_cx) + 0.5, double(ps.builder_cy) + 0.5, cz, safe_int(field(p, 3, "4"), 1, 20, 4), safe_int(field(p, 4, "45"), 5, 600, 45));
	else if (cmd == "emitter") quick_line = make_a_line(wire_unescape(field(p, 2, "Beacon")), field(p, 3, "builder/beacon_ping.ogg"), double(ps.builder_cx) + 0.5, double(ps.builder_cy) + 0.5, cz, safe_int(field(p, 4, "24"), 4, 80, 24), safe_double(field(p, 5, "0.65"), 0.1, 1.0, 0.65));
	else if (cmd == "spawn") quick_line = make_s_line(wire_unescape(field(p, 2, "Spawn")), double(ps.builder_cx) + 0.5, double(ps.builder_cy) + 0.5, cz, 0);

	if (quick_line.length() > 0) {
		mi.push_undo();
		string err;
		if (mi.map.lm_append_line(quick_line, err)) {
			ps.builder_has_mark = false;
			builder_reload_map_clients(ctx, mi);
			ctx.send_speech(ps, MBUF_GAME, true, "Added " + cmd + " to " + mi.map.name + ".");
		} else {
			ctx.send_speech(ps, MBUF_SYSTEM, true, err);
		}
	}
}
