// Server multi-map world simulation: persistent structures, resource nodes, vitals,
// 3D movement, stairs surface climbing, true air/void gravity & fall trauma, portals,
// hazards, crafting, gathering, loot drops, and day/night/weather.

#include "state.nvgt"

string encode_chest_items(ItemStack@[]@ items) {
	return encode_item_stacks(items);
}

void decode_chest_items(const string&in encoded, ItemStack@[]@ out_items) {
	decode_item_stacks(encoded, out_items, MAX_CHEST_SLOTS);
}

void world_init_nodes(ServerCtx@ ctx, MapInstance@ mi) {
	if (@mi == null) return;
	mi.nodes.resize(0);
	for (uint i = 0; i < mi.map.resources.length(); i++) {
		MapResourceSpawn@ r = mi.map.resources[i];
		ResourceNode rn;
		rn.id = ctx.next_entity_id++;
		rn.type = r.type;
		rn.x = r.x; rn.y = r.y; rn.z = r.z;
		rn.max_charges = r.max_charges;
		rn.charges = r.max_charges;
		rn.respawn_sec = r.respawn_sec;
		mi.nodes.insert_last(rn);
	}
}

void world_init_all_nodes(ServerCtx@ ctx) {
	for (uint i = 0; i < ctx.maps.length(); i++) {
		world_init_nodes(ctx, ctx.maps[i]);
	}
}

bool world_load_objects(ServerCtx@ ctx, string&out err) {
	err = "";
	ctx.structures.resize(0);
	if (!file_exists(ctx.objects_db_path)) {
		ctx.sync_all_map_occluders();
		return true;
	}
	string raw = file_get_contents(ctx.objects_db_path);
	if (raw.length() == 0) {
		err = "World objects database exists but is empty: " + ctx.objects_db_path;
		return false;
	}
	string[]@ lines = split_keep_empty(raw.replace("\r", "", true), "\n");
	bool saw_hdr = false;
	for (uint i = 0; i < lines.length(); i++) {
		string ln = lines[i].trim_whitespace();
		if (ln.length() == 0 || ln.starts_with("#")) continue;
		if (!saw_hdr && ln == "OBJECTS_V1") { saw_hdr = true; continue; }
		string[]@ p = split_keep_empty(ln, FIELD_SEP);
		if (field(p, 0) != "OBJ" || field(p, 1) != "v1" || p.length() < 16) {
			err = "Corrupt world object line " + (i + 1);
			return false;
		}
		WorldStructure st;
		st.id = uint64(parse_int(field(p, 2, "0")));
		st.map_name = wire_unescape(field(p, 3, ctx.default_map_slug));
		st.type = field(p, 4, "wood_wall");
		st.owner = sanitize_name(field(p, 5, "Server"));
		st.x = safe_double(field(p, 6, "0"), 0.0, 500.0, 0.0);
		st.y = safe_double(field(p, 7, "0"), 0.0, 500.0, 0.0);
		st.z = safe_double(field(p, 8, "0"), double(MAP_MIN_Z), double(MAP_MAX_Z), 0.0);
		st.facing = safe_int(field(p, 9, "0"), 0, 359, 0);
		st.max_hp = safe_int(field(p, 11, "100"), 1, 1000, 100);
		st.hp = safe_int(field(p, 10, "100"), 1, st.max_hp, st.max_hp);
		st.locked = safe_int(field(p, 12, "0"), 0, 1, 0) == 1;
		st.is_open = safe_int(field(p, 13, "0"), 0, 1, 0) == 1;
		st.fuel_sec = safe_int(field(p, 14, "0"), 0, 1000, 0);
		decode_chest_items(field(p, 15, "-"), st.chest_items);
		if (st.id >= ctx.next_entity_id) ctx.next_entity_id = st.id + 1;
		ctx.structures.insert_last(st);
	}
	if (!saw_hdr) { err = "Missing OBJECTS_V1 header"; return false; }
	ctx.sync_all_map_occluders();
	return true;
}

bool world_save_objects(ServerCtx@ ctx, string&out err) {
	err = "";
	int slash = ctx.objects_db_path.rfind("/");
	if (slash > 0) {
		string dir = ctx.objects_db_path.substr(0, uint(slash));
		if (!directory_exists(dir)) directory_create(dir);
	}
	string buf = "OBJECTS_V1\n";
	for (uint i = 0; i < ctx.structures.length(); i++) {
		WorldStructure@ st = ctx.structures[i];
		buf += "OBJ|v1|" + st.id + "|" + wire_escape(st.map_name) + "|" + st.type + "|" + st.owner + "|"
			+ fmt2(st.x) + "|" + fmt2(st.y) + "|" + fmt2(st.z) + "|" + st.facing + "|" + st.hp + "|"
			+ st.max_hp + "|" + (st.locked ? "1" : "0") + "|" + (st.is_open ? "1" : "0") + "|"
			+ st.fuel_sec + "|" + encode_chest_items(st.chest_items) + "\n";
	}
	string tmp = ctx.objects_db_path + ".tmp";
	string bak = ctx.objects_db_path + ".bak";
	if (!file_put_contents(tmp, buf, false)) { err = "Failed to write temp objects file"; return false; }
	if (file_exists(ctx.objects_db_path)) {
		file_copy(ctx.objects_db_path, bak, true);
		file_delete(ctx.objects_db_path);
	}
	if (!file_move(tmp, ctx.objects_db_path)) {
		if (!file_copy(tmp, ctx.objects_db_path, true)) { err = "Failed to replace world objects db"; return false; }
		file_delete(tmp);
	}
	ctx.objects_dirty = false;
	return true;
}

bool world_near_structure(ServerCtx@ ctx, MapInstance@ mi, double x, double y, double z, const string&in type, double max_dist = 3.5) {
	for (uint i = 0; i < ctx.structures.length(); i++) {
		WorldStructure@ st = ctx.structures[i];
		if (!ctx.struct_on_map(st, mi) || st.type != type) continue;
		if (st.type == "campfire" && st.fuel_sec <= 0) continue;
		if (get_3d_distance(x, y, z, st.x, st.y, st.z) <= max_dist) return true;
	}
	return false;
}

bool world_near_emitter_campfire(ServerCtx@ ctx, MapInstance@ mi, double x, double y, double z) {
	if (@mi != null) {
		for (uint i = 0; i < mi.map.emitters.length(); i++) {
			MapEmitter@ e = mi.map.emitters[i];
			if (e.sound_file.find("campfire") >= 0 && get_3d_distance(x, y, z, e.x, e.y, e.z) <= 4.5) return true;
		}
	}
	return world_near_structure(ctx, mi, x, y, z, "campfire", 4.5);
}

void world_spawn_drop(ServerCtx@ ctx, MapInstance@ mi, const string&in item_id, int qty, double x, double y, double z, uint64 now_ms) {
	if (@mi == null || qty <= 0) return;
	LootDrop d;
	d.id = ctx.next_entity_id++;
	d.item_id = item_id;
	d.qty = qty;
	d.x = x; d.y = y; d.z = z;
	d.expires_ms = now_ms + 180000;
	mi.drops.insert_last(d);
}

void world_respawn_player(ServerCtx@ ctx, PlayerSession@ ps) {
	MapInstance@ mi = ctx.player_map(ps);
	if (@mi == null || mi.map.spawns.length() == 0) @mi = ctx.default_map();
	MapSpawn@ sp = (@mi != null && mi.map.spawns.length() > 0) ? mi.map.spawns[0] : null;
	if (@mi != null && mi.slug != ps.current_map) {
		ps.current_map = mi.slug;
		ctx.send_map_sync(ps);
	}
	ps.x = double(round_coord(@sp != null ? sp.x : 50.0));
	ps.y = double(round_coord(@sp != null ? sp.y : 46.0));
	ps.z = @sp != null ? sp.z : 0.0;
	ps.vx = 0.0; ps.vy = 0.0; ps.vz = 0.0;
	ps.step_rem_x = 0.0; ps.step_rem_y = 0.0; ps.was_moving = false;
	ps.on_ground = true;
	ps.fall_start_z = ps.z;
	ps.fall_air_sfx_sent = false;
	ps.fracture_until_ms = 0;
	ps.hp = 100;
	ps.hunger = 80;
	ps.thirst = 80;
	ps.stamina = 100;
	ps.warmth = 90;
	ps.duel_opponent = "";
	ps.duel_until_ms = 0;
	if (@mi != null) {
		ctx.broadcast_sfx_3d(mi.slug, "world", "combat/respawn.ogg", ps.x, ps.y, ps.z, 0.85, 20.0);
		ctx.send_speech(ps, MBUF_GAME, true, "Respawned at " + mi.map.zone_name_at(ps.x, ps.y, ps.z) + " in " + mi.map.name + ".");
	}
}

void world_kill_env(ServerCtx@ ctx, PlayerSession@ victim, const string&in cause) {
	if (@victim == null || !victim.authed || victim.peer_id == 0) return;
	MapInstance@ mi = ctx.player_map(victim);
	string mslug = @mi != null ? mi.slug : victim.current_map;
	ctx.broadcast_sfx_3d(mslug, "threat", "combat/death.ogg", victim.x, victim.y, victim.z, 0.95, 30.0);
	if (@victim.account != null) { victim.account.deaths++; ctx.accounts.dirty = true; }
	ctx.broadcast_speech_map(mslug, MBUF_GAME, false, victim.name + " died from " + cause + ".");
	ctx.send_speech(victim, MBUF_GAME, true, "You died from " + cause + ".");
	world_respawn_player(ctx, victim);
}

bool world_transfer_player_map(ServerCtx@ ctx, PlayerSession@ ps, MapInstance@ dest, double dx, double dy, double dz, int dfac, const string&in travel_sfx = "world/portal_travel.ogg", bool is_portal = false) {
	if (@ps == null || @dest == null) return false;
	string old_map = ps.current_map;
	if (old_map != dest.slug && travel_sfx.length() > 0 && travel_sfx != "none") {
		ctx.broadcast_sfx_3d(old_map, "world", travel_sfx, ps.x, ps.y, ps.z, 0.7, 18.0);
	}
	ps.current_map = dest.slug;
	ps.x = double(round_coord(clampd(dx, 1.0, double(dest.map.width - 1))));
	ps.y = double(round_coord(clampd(dy, 1.0, double(dest.map.height - 1))));
	ps.z = clampd(dz, double(dest.map.min_z), double(dest.map.max_z));
	ps.facing = wrap_deg(dfac);
	ps.vx = 0.0; ps.vy = 0.0; ps.vz = 0.0;
	ps.step_rem_x = 0.0; ps.step_rem_y = 0.0; ps.was_moving = false;
	ps.on_ground = true;
	ps.fall_start_z = ps.z;
	ps.fall_air_sfx_sent = false;
	ps.last_zone = "";
	ps.duel_opponent = "";
	ps.duel_until_ms = 0;

	if (@ps.account != null) {
		ps.account.current_map = dest.slug;
		ps.account.last_x = ps.x;
		ps.account.last_y = ps.y;
		ps.account.last_z = ps.z;
		ctx.accounts.dirty = true;
	}

	if (old_map != dest.slug) {
		ctx.send_control(ps, pkt_build("MAP_TRANSFER", {
			wire_escape(dest.slug), wire_escape(dest.map.name),
			fmt2(ps.x), fmt2(ps.y), fmt2(ps.z), "" + ps.facing
		}));
		ctx.send_map_sync(ps);
		if (travel_sfx.length() > 0 && travel_sfx != "none") {
			ctx.send_sfx_to(ps, "self", travel_sfx, ps.x, ps.y, ps.z, 0.85);
			ctx.broadcast_sfx_3d(dest.slug, "world", travel_sfx, ps.x, ps.y, ps.z, 0.75, 22.0);
		}
		ctx.send_speech(ps, MBUF_GAME, true, "Entered " + dest.map.name + ", " + dest.map.zone_name_at(ps.x, ps.y, ps.z) + ".");
	} else if (is_portal) {
		if (travel_sfx.length() > 0 && travel_sfx != "none") {
			ctx.send_sfx_to(ps, "self", travel_sfx, ps.x, ps.y, ps.z, 0.85);
			ctx.broadcast_sfx_3d(dest.slug, "world", travel_sfx, ps.x, ps.y, ps.z, 0.75, 22.0);
		}
		ctx.send_speech(ps, MBUF_GAME, true, dest.map.zone_name_at(ps.x, ps.y, ps.z) + ", height " + int(ps.z) + ".");
	} else {
		ctx.send_speech(ps, MBUF_SYSTEM, true, "Teleported to " + int(ps.x) + ", " + int(ps.y) + ", Z " + int(ps.z) + " on " + dest.map.name + ".");
	}
	return true;
}

void world_handle_climb(ServerCtx@ ctx, PlayerSession@ ps, int dir, uint64 now_ms, uint64 min_cd_ms = 200) {
	if (@ps == null || !ps.authed || ps.peer_id == 0) return;
	if (now_ms - ps.last_climb_ms < min_cd_ms) return;
	MapInstance@ mi = ctx.player_map(ps);
	if (@mi == null) return;
	MapPlatform@ stair = mi.map.find_stair_at(ps.x, ps.y, ps.z);
	if (@stair == null) return;

	double next_z = ps.z + double(dir);
	if (next_z > stair.max_z) next_z = stair.max_z;
	if (next_z < stair.min_z) next_z = stair.min_z;
	if (abs(next_z - ps.z) < 0.05) {
		ps.last_climb_ms = now_ms;
		ctx.send_sfx_to(ps, "self", "ui/menu_edge.ogg", ps.x, ps.y, ps.z, 0.45);
		return;
	}
	string mat;
	if (mi.map.blocked_by_wall(ps.x, ps.y, next_z, PLAYER_RADIUS, mat)) {
		ps.last_climb_ms = now_ms;
		ctx.send_sfx_to(ps, "self", mat == "stone" ? "steps/wall_bump_stone.ogg" : "steps/wall_bump_wood.ogg", ps.x, ps.y, ps.z, 0.7);
		return;
	}

	ps.last_climb_ms = now_ms;
	ps.z = next_z;
	ps.vz = 0.0;
	ps.on_ground = true;
	ps.fall_start_z = ps.z;
	ps.fall_air_sfx_sent = false;

	// Play footstep sound matching the staircase's builder-selected surface!
	string surf = stair.surface.length() > 0 ? stair.surface : "wood";
	string sfx = "steps/" + surf + "_" + random(1, 3) + ".ogg";
	ctx.send_sfx_to(ps, "self", sfx, ps.x, ps.y, ps.z, 0.78);
	string pkt = pkt_build("SFX", {"actors", sfx, fmt2(ps.x), fmt2(ps.y), fmt2(ps.z), "0.70", "1"});
	for (uint i = 0; i < ctx.sessions.length(); i++) {
		PlayerSession@ other = ctx.sessions[i];
		if (@other == @ps || !other.authed || other.peer_id == 0 || other.current_map != mi.slug) continue;
		if (get_3d_distance(other.x, other.y, other.z, ps.x, ps.y, ps.z) <= 22.0) {
			ctx.send_ch(other.peer_id, CH_AUDIO, pkt, true);
		}
	}
}

void world_apply_fall_landing(ServerCtx@ ctx, MapInstance@ mi, PlayerSession@ ps, double landed_z, bool is_deep_water, uint64 now_ms) {
	double drop = ps.fall_start_z - landed_z;
	ps.z = landed_z;
	ps.vz = 0.0;
	ps.on_ground = true;
	ps.fall_air_sfx_sent = false;

	if (is_deep_water && drop > 1.2) {
		ctx.broadcast_sfx_3d(mi.slug, "actors", "steps/water_splash_big.ogg", ps.x, ps.y, ps.z, 0.9, 24.0);
		if (drop > 4.0) ctx.send_speech(ps, MBUF_GAME, false, "Splashed safely into deep water.");
		return;
	}
	if (drop > 5.5) {
		int fdmg = clampi(int((drop - 3.0) * 8.5), 18, 100);
		ctx.broadcast_sfx_3d(mi.slug, "actors", "steps/land_hard.ogg", ps.x, ps.y, ps.z, 0.95, 22.0);
		ctx.broadcast_sfx_3d(mi.slug, "actors", "combat/bone_break.ogg", ps.x, ps.y, ps.z, 0.95, 20.0);
		if (ps.hp - fdmg <= 0) {
			world_kill_env(ctx, ps, "a " + int(drop + 0.5) + "-step fall");
			return;
		}
		ps.hp = clampi(ps.hp - fdmg, 1, 100);
		if (drop > 6.5) {
			ps.fracture_until_ms = now_ms + 25000;
			ctx.send_speech(ps, MBUF_GAME, true, "Bone-cracking fall! Fractured leg, took " + fdmg + " damage. Use a bandage or splint.");
		} else {
			ctx.send_speech(ps, MBUF_GAME, true, "Severe fall! Took " + fdmg + " fall damage.");
		}
	} else if (drop > 2.5) {
		int fdmg = clampi(int((drop - 2.0) * 5.0), 4, 22);
		ctx.broadcast_sfx_3d(mi.slug, "actors", "steps/land_hard.ogg", ps.x, ps.y, ps.z, 0.85, 20.0);
		if (ps.hp - fdmg <= 0) {
			world_kill_env(ctx, ps, "a high fall");
			return;
		}
		ps.hp = clampi(ps.hp - fdmg, 1, 100);
		ctx.send_speech(ps, MBUF_GAME, true, "Hard landing, took " + fdmg + " fall damage.");
	} else if (drop > 0.6) {
		ctx.broadcast_sfx_3d(mi.slug, "actors", "steps/land_soft.ogg", ps.x, ps.y, ps.z, 0.7, 15.0);
	}
}

void world_step_player_move(ServerCtx@ ctx, PlayerSession@ ps, double dt, uint64 now_ms) {
	if (!ps.authed || ps.peer_id == 0) {
		ps.vx = 0.0; ps.vy = 0.0; ps.was_moving = false;
		return;
	}
	if (ps.builder_mode && !ps.builder_noclip) {
		ps.vx = 0.0; ps.vy = 0.0; ps.was_moving = false;
		return;
	}
	MapInstance@ mi = ctx.player_map(ps);
	if (@mi == null) return;

	double fwd_x = bearing_x(ps.facing);
	double fwd_y = bearing_y(ps.facing);
	double right_x = bearing_x(wrap_deg(ps.facing + 90));
	double right_y = bearing_y(wrap_deg(ps.facing + 90));

	double move_x = 0.0, move_y = 0.0;
	if ((ps.input_mask & IN_FWD) != 0) { move_x += fwd_x; move_y += fwd_y; }
	if ((ps.input_mask & IN_BACK) != 0) { move_x -= fwd_x; move_y -= fwd_y; }
	if ((ps.input_mask & IN_RIGHT) != 0) { move_x += right_x; move_y += right_y; }
	if ((ps.input_mask & IN_LEFT) != 0) { move_x -= right_x; move_y -= right_y; }

	double mag = sqrt(move_x * move_x + move_y * move_y);
	bool fractured = ps.is_fractured(now_ms);
	bool want_sprint = !fractured && (ps.input_mask & IN_SPRINT) != 0 && mag > 0.01 && ps.stamina > 5;
	string surf = mi.map.surface_at(ps.x, ps.y, ps.z);
	bool stepped_horizontally = false;

	if (mag > 0.001) {
		move_x /= mag;
		move_y /= mag;
		// Chebyshev normalization so cardinal and 45-degree diagonals step exact +-1 integer tiles.
		double ax = abs(move_x);
		double ay = abs(move_y);
		double max_c = ax > ay ? ax : ay;
		if (max_c > 0.001) {
			move_x /= max_c;
			move_y /= max_c;
		}

		uint64 step_iv = want_sprint ? SPRINT_STEP_MS : WALK_STEP_MS;
		if (ps.builder_noclip) {
			step_iv = 75;
		} else {
			if (surf == "water") step_iv = uint64(double(step_iv) / 0.65);
			if (ps.blocking) step_iv = uint64(double(step_iv) / 0.45);
			if (fractured) step_iv = uint64(double(step_iv) / 0.65);
		}

		bool first_tap = !ps.was_moving && (now_ms - ps.last_move_ms >= 90);
		bool ready_step = first_tap || (now_ms - ps.last_move_ms >= step_iv);
		ps.was_moving = true;
		ps.vx = move_x;
		ps.vy = move_y;

		if (ready_step) {
			ps.last_move_ms = now_ms;
			int cur_ix = round_coord(ps.x);
			int cur_iy = round_coord(ps.y);
			double tx = double(cur_ix) + move_x + ps.step_rem_x;
			double ty = double(cur_iy) + move_y + ps.step_rem_y;
			int target_ix = round_coord(tx);
			int target_iy = round_coord(ty);
			ps.step_rem_x = tx - double(target_ix);
			ps.step_rem_y = ty - double(target_iy);

			if (ps.builder_noclip) {
				ps.x = clampd(double(target_ix), 1.0, double(mi.map.width - 1));
				ps.y = clampd(double(target_iy), 1.0, double(mi.map.height - 1));
			} else {
				// Axis-separated wall sliding on integer grid cells.
				int next_ix = cur_ix;
				int next_iy = cur_iy;
				string hit_mat_x, hit_mat_y;
				bool bumped = false;
				string bump_mat = "wood";
				if (target_ix != cur_ix) {
					if (!mi.map.blocked_by_wall(double(target_ix), double(cur_iy), ps.z, PLAYER_RADIUS, hit_mat_x)) {
						next_ix = target_ix;
					} else {
						bumped = true;
						bump_mat = hit_mat_x;
					}
				}
				if (target_iy != cur_iy) {
					if (!mi.map.blocked_by_wall(double(next_ix), double(target_iy), ps.z, PLAYER_RADIUS, hit_mat_y)) {
						next_iy = target_iy;
					} else {
						bumped = true;
						bump_mat = hit_mat_y;
					}
				}
				ps.x = double(next_ix);
				ps.y = double(next_iy);
				stepped_horizontally = (next_ix != cur_ix || next_iy != cur_iy);
				if (!stepped_horizontally) {
					ps.vx = 0.0;
					ps.vy = 0.0;
				}
				if (bumped && now_ms - ps.last_wall_bump_ms >= 350) {
					ps.last_wall_bump_ms = now_ms;
					string wsfx = bump_mat == "stone" ? "steps/wall_bump_stone.ogg" : "steps/wall_bump_wood.ogg";
					ctx.send_sfx_to(ps, "self", wsfx, ps.x, ps.y, ps.z, 0.75);
				}
			}
		}
	} else {
		ps.vx = 0.0;
		ps.vy = 0.0;
		ps.was_moving = false;
		ps.step_rem_x = 0.0;
		ps.step_rem_y = 0.0;
	}

	if (ps.builder_noclip) {
		if ((ps.input_mask & IN_CLIMB_UP) != 0 && now_ms - ps.last_climb_ms >= 100) {
			ps.last_climb_ms = now_ms;
			ps.z = clampd(ps.z + 1.0, double(mi.map.min_z), double(mi.map.max_z));
		}
		if ((ps.input_mask & IN_CLIMB_DOWN) != 0 && now_ms - ps.last_climb_ms >= 100) {
			ps.last_climb_ms = now_ms;
			ps.z = clampd(ps.z - 1.0, double(mi.map.min_z), double(mi.map.max_z));
		}
		ps.vz = 0.0; ps.on_ground = true;
		return;
	}

	// Staircase climbing (PageUp / PageDown) & mid-stair suspension
	if ((ps.input_mask & IN_CLIMB_UP) != 0) world_handle_climb(ctx, ps, 1, now_ms, 200);
	else if ((ps.input_mask & IN_CLIMB_DOWN) != 0) world_handle_climb(ctx, ps, -1, now_ms, 200);

	MapPlatform@ on_stair = mi.map.find_stair_at(ps.x, ps.y, ps.z);
	if (@on_stair != null) {
		ps.z = clampd(ps.z, on_stair.min_z, on_stair.max_z);
		ps.vz = 0.0;
		ps.on_ground = true;
		ps.fall_start_z = ps.z;
		ps.fall_air_sfx_sent = false;
	} else {
		// True Air/Void Law, Directional Ramp Adhesion & Z Gravity
		double sup_z; string sup_surf; bool deep_w; bool under_roof; bool on_ramp; double ramp_slope;
		bool has_sup = mi.map.find_support_ex(ps.x, ps.y, ps.z, sup_z, sup_surf, deep_w, under_roof, on_ramp, ramp_slope);

		if (ps.on_ground && has_sup && !fractured && (ps.input_mask & IN_JUMP) != 0 && ps.stamina >= 8) {
			ps.on_ground = false;
			ps.vz = JUMP_VEL;
			ps.fall_start_z = ps.z;
			ps.fall_air_sfx_sent = false;
			ps.stamina = clampi(ps.stamina - 8, 0, 100);
			ctx.broadcast_sfx_3d(mi.slug, "actors", "steps/jump.ogg", ps.x, ps.y, ps.z, 0.75, 18.0);
		}

		double max_ramp_drop = on_ramp ? clampd(1.05 + ramp_slope * 1.15, 1.05, 12.0) : 0.05;
		if (!ps.on_ground || !has_sup || ps.z > sup_z + max_ramp_drop) {
			if (ps.on_ground) {
				ps.on_ground = false;
				ps.fall_start_z = ps.z;
				ps.fall_air_sfx_sent = false;
			}
			ps.vz -= GRAVITY_PER_SEC * dt;
			ps.z += ps.vz * dt;
			if (!ps.fall_air_sfx_sent && (ps.fall_start_z - ps.z > 2.2 || ps.vz < -7.5)) {
				ps.fall_air_sfx_sent = true;
				ctx.broadcast_sfx_3d(mi.slug, "actors", "steps/fall_air.ogg", ps.x, ps.y, ps.z, 0.85, 22.0);
			}
			bool has_sup2 = mi.map.find_support_at(ps.x, ps.y, ps.z, sup_z, sup_surf, deep_w, under_roof);
			if (has_sup2 && ps.z <= sup_z) {
				world_apply_fall_landing(ctx, mi, ps, sup_z, deep_w, now_ms);
			} else if (!has_sup2 && ps.z < double(mi.map.min_z) - 6.0) {
				world_kill_env(ctx, ps, "falling into the void");
				return;
			}
		} else {
			ps.z = sup_z;
			ps.vz = 0.0;
			ps.fall_start_z = ps.z;
		}
	}

	// Auto-step Map Portals & Hazard Zones
	MapPortal@ prt = mi.map.find_portal_at(ps.x, ps.y, ps.z);
	if (@prt != null && prt.auto_step) {
		MapInstance@ dest = ctx.find_map(prt.target_map);
		if (@dest != null) {
			world_transfer_player_map(ctx, ps, dest, prt.dest_x, prt.dest_y, prt.dest_z, prt.dest_facing, prt.sound_file, true);
			return;
		}
	}

	MapHazard@ hz = mi.map.find_hazard_at(ps.x, ps.y, ps.z);
	if (@hz != null && now_ms - ps.last_hazard_ms >= uint64(hz.interval_ms)) {
		ps.last_hazard_ms = now_ms;
		ctx.broadcast_sfx_3d(mi.slug, "threat", hz.sound_file, ps.x, ps.y, ps.z, 0.9, 20.0);
		if (ps.hp - hz.damage <= 0) {
			world_kill_env(ctx, ps, hz.label);
			return;
		}
		ps.hp = clampi(ps.hp - hz.damage, 1, 100);
		ctx.send_speech(ps, MBUF_GAME, true, hz.label + " hits you for " + hz.damage + " damage! Health " + ps.hp + ".");
	}

	// Zone transition announcement & footsteps to OTHER players (local steps sound immediately on client).
	string zname = mi.map.zone_name_at(ps.x, ps.y, ps.z);
	if (zname != ps.last_zone) {
		bool first = ps.last_zone.length() == 0;
		ps.last_zone = zname;
		if (!first) {
			string safe_note = mi.map.is_safe_at(ps.x, ps.y, ps.z) ? " Safe zone." : "";
			ctx.send_speech(ps, MBUF_GAME, false, "Entered " + zname + "." + safe_note);
		}
	}
	if (stepped_horizontally && ps.on_ground && @on_stair == null) {
		ps.last_step_sfx_ms = now_ms;
		string step_surf = mi.map.surface_at(ps.x, ps.y, ps.z);
		string sfx = "steps/" + step_surf + "_" + random(1, 3) + ".ogg";
		string pkt = pkt_build("SFX", {"actors", sfx, fmt2(ps.x), fmt2(ps.y), fmt2(ps.z), "0.70", "1"});
		for (uint i = 0; i < ctx.sessions.length(); i++) {
			PlayerSession@ other = ctx.sessions[i];
			if (@other == @ps || !other.authed || other.peer_id == 0 || other.current_map != mi.slug) continue;
			if (get_3d_distance(other.x, other.y, other.z, ps.x, ps.y, ps.z) <= 22.0) {
				ctx.send_ch(other.peer_id, CH_AUDIO, pkt, true);
			}
		}
	}
}

void world_step_vitals_and_env(ServerCtx@ ctx, uint64 now_ms) {
	// Per-map resource respawns & drop expiration
	for (uint mi_idx = 0; mi_idx < ctx.maps.length(); mi_idx++) {
		MapInstance@ mi = ctx.maps[mi_idx];
		for (uint i = 0; i < mi.nodes.length(); i++) {
			ResourceNode@ rn = mi.nodes[i];
			if (rn.charges < rn.max_charges && now_ms >= rn.next_respawn_ms) {
				rn.charges = rn.max_charges;
			}
		}
		for (int i = int(mi.drops.length()) - 1; i >= 0; i--) {
			if (now_ms >= mi.drops[uint(i)].expires_ms) mi.drops.remove_at(uint(i));
		}
	}

	if (ctx.tick_count % uint64(TICK_HZ) == 0) {
		ctx.cycle_sec = (ctx.cycle_sec + 1) % 1200;
		bool now_night = ctx.cycle_sec >= 720;
		if (now_night != ctx.is_night) {
			ctx.is_night = now_night;
			ctx.broadcast_speech(MBUF_GAME, false, ctx.is_night ? "Night falls over the world. Stay near a fire for warmth." : "Dawn breaks across the world.");
		}
		if (now_ms >= ctx.next_weather_ms) {
			ctx.next_weather_ms = now_ms + uint64(random(120, 240)) * 1000;
			bool next_rain = random(1, 100) <= 30;
			if (next_rain != ctx.is_raining) {
				ctx.is_raining = next_rain;
				ctx.broadcast_speech(MBUF_GAME, false, ctx.is_raining ? "Rain begins to fall." : "The rain clears up.");
			}
		}
		for (int i = int(ctx.structures.length()) - 1; i >= 0; i--) {
			WorldStructure@ st = ctx.structures[uint(i)];
			if (st.type == "campfire" && st.fuel_sec > 0) {
				st.fuel_sec--;
				if (st.fuel_sec == 0) ctx.objects_dirty = true;
			}
		}
	}

	for (uint i = 0; i < ctx.sessions.length(); i++) {
		PlayerSession@ ps = ctx.sessions[i];
		if (!ps.authed || ps.peer_id == 0) continue;
		if ((ps.input_mask & IN_SPRINT) != 0 && (ps.vx != 0.0 || ps.vy != 0.0) && !ps.is_fractured(now_ms)) {
			if (ctx.tick_count % 6 == 0) ps.stamina = clampi(ps.stamina - 2, 0, 100);
		} else {
			if (ctx.tick_count % 5 == 0) ps.stamina = clampi(ps.stamina + 3, 0, 100);
		}
		if (ps.blocking && now_ms > ps.block_until_ms) ps.blocking = false;

		if (now_ms - ps.last_vital_tick_ms < 3000) continue;
		ps.last_vital_tick_ms = now_ms;

		MapInstance@ mi = ctx.player_map(ps);
		bool safe = @mi != null && mi.map.is_safe_at(ps.x, ps.y, ps.z);
		if (!safe && ctx.tick_count % (uint64(TICK_HZ) * 18) < uint64(TICK_HZ * 3)) {
			ps.hunger = clampi(ps.hunger - 1, 0, 100);
			ps.thirst = clampi(ps.thirst - 1, 0, 100);
		}
		double sz; string ss; bool dw; bool under_roof = false;
		if (@mi != null) mi.map.find_support_at(ps.x, ps.y, ps.z, sz, ss, dw, under_roof);

		bool near_fire = world_near_emitter_campfire(ctx, mi, ps.x, ps.y, ps.z);
		ItemStack@ eq = ps.active_item();
		bool holding_torch = @eq != null && eq.id == "torch";
		if (near_fire || holding_torch) {
			ps.warmth = clampi(ps.warmth + 6, 0, 100);
		} else if (!under_roof && (ctx.is_map_night(mi) || ctx.is_map_raining(mi))) {
			ps.warmth = clampi(ps.warmth - (ctx.is_map_raining(mi) ? 2 : 1), 0, 100);
		} else {
			ps.warmth = clampi(ps.warmth + 1, 0, 100);
		}

		if (ps.hunger == 0 || ps.thirst == 0 || ps.warmth == 0) {
			ps.hp = clampi(ps.hp - 2, 0, 100);
			if (now_ms - ps.last_vital_warn_ms >= 12000) {
				ps.last_vital_warn_ms = now_ms;
				string reason = ps.thirst == 0 ? "dehydration" : (ps.hunger == 0 ? "starvation" : "hypothermia");
				ctx.send_speech(ps, MBUF_GAME, true, "Warning: losing health from " + reason + ".");
			}
		} else if (ps.hunger > 60 && ps.thirst > 60 && ps.warmth > 50 && ps.hp < 100) {
			ps.hp = clampi(ps.hp + 1, 0, 100);
		}
		if (ps.warmth <= 20 && now_ms - ps.last_vital_warn_ms >= 10000) {
			ps.last_vital_warn_ms = now_ms;
			ctx.send_sfx_to(ps, "self", "survival/shiver.ogg", ps.x, ps.y, ps.z, 0.8);
		}
		if (ps.hp <= 25 && now_ms - ps.last_heartbeat_ms >= 3000) {
			ps.last_heartbeat_ms = now_ms;
			ctx.send_sfx_to(ps, "self", "survival/heartbeat.ogg", ps.x, ps.y, ps.z, 0.85);
		}
	}
}

void world_handle_gather(ServerCtx@ ctx, PlayerSession@ ps, uint64 now_ms) {
	if (now_ms - ps.last_gather_ms < 650) {
		ctx.send_sfx_to(ps, "self", "ui/error.ogg", ps.x, ps.y, ps.z, 0.7);
		return;
	}
	ps.last_gather_ms = now_ms;
	MapInstance@ mi = ctx.player_map(ps);
	if (@mi == null) return;

	// 0. Check non-auto Map Portal interaction nearby
	MapPortal@ prt = mi.map.find_portal_at(ps.x, ps.y, ps.z);
	if (@prt != null) {
		MapInstance@ dest = ctx.find_map(prt.target_map);
		if (@dest != null) {
			world_transfer_player_map(ctx, ps, dest, prt.dest_x, prt.dest_y, prt.dest_z, prt.dest_facing, prt.sound_file, true);
			return;
		}
	}

	// 1. Check nearby loot drops first.
	for (int i = int(mi.drops.length()) - 1; i >= 0; i--) {
		LootDrop@ d = mi.drops[uint(i)];
		if (get_3d_distance(ps.x, ps.y, ps.z, d.x, d.y, d.z) <= 2.5) {
			if (ps.add_item(d.item_id, d.qty)) {
				ItemDef@ def = find_item(d.item_id);
				string iname = @def != null ? def.name : d.item_id;
				ctx.send_speech(ps, MBUF_GAME, false, "Picked up " + d.qty + " " + iname + ".");
				ctx.send_sfx_to(ps, "self", "ui/menu_select.ogg", ps.x, ps.y, ps.z, 0.8);
				mi.drops.remove_at(uint(i));
				ctx.send_inv(ps);
			} else {
				ctx.send_speech(ps, MBUF_GAME, true, "Inventory is full.");
			}
			return;
		}
	}

	// 2. Check water scooping / drinking if standing at or near water.
	string surf = mi.map.surface_at(ps.x, ps.y, ps.z);
	if (surf == "water") {
		if (ps.count_item("water_flask_empty") > 0) {
			ps.remove_item("water_flask_empty", 1);
			ps.add_item("water_flask_full", 1);
			ctx.broadcast_sfx_3d(mi.slug, "world", "survival/water_scoop.ogg", ps.x, ps.y, ps.z, 0.85, 18.0);
			ctx.send_speech(ps, MBUF_GAME, false, "Filled water flask.");
			ctx.send_inv(ps);
		} else {
			ps.thirst = clampi(ps.thirst + 30, 0, 100);
			ctx.broadcast_sfx_3d(mi.slug, "world", "survival/drink.ogg", ps.x, ps.y, ps.z, 0.8, 14.0);
			ctx.send_speech(ps, MBUF_GAME, false, "Drank fresh stream water. Thirst " + ps.thirst + " percent.");
		}
		return;
	}

	// 3. Find closest resource node within 2.8 tiles.
	ResourceNode@ best = null;
	double best_d = 2.8;
	for (uint i = 0; i < mi.nodes.length(); i++) {
		ResourceNode@ rn = mi.nodes[i];
		if (rn.charges <= 0) continue;
		double dist = get_3d_distance(ps.x, ps.y, ps.z, rn.x, rn.y, rn.z);
		if (dist <= best_d) {
			best_d = dist;
			@best = @rn;
		}
	}
	if (@best == null) {
		ctx.send_sfx_to(ps, "self", "ui/error.ogg", ps.x, ps.y, ps.z, 0.6);
		ctx.send_speech(ps, MBUF_GAME, false, "Nothing to gather or interact with right here.");
		return;
	}

	ItemStack@ eq = ps.active_item();
	string eq_id = @eq != null ? eq.id : "";
	string yield_id = "wood";
	int yield_qty = 1;
	string sfx = "survival/forage_berry.ogg";

	if (best.type == "tree") {
		yield_id = "wood";
		yield_qty = (eq_id == "iron_axe") ? 3 : (eq_id == "stone_axe" ? 2 : 1);
		sfx = "survival/chop_wood.ogg";
	} else if (best.type == "rock" || best.type == "iron_vein") {
		if (eq_id != "stone_pickaxe" && eq_id != "iron_axe" && best.type == "iron_vein") {
			ctx.send_sfx_to(ps, "self", "ui/error.ogg", ps.x, ps.y, ps.z, 0.7);
			ctx.send_speech(ps, MBUF_GAME, true, "You need a stone pickaxe equipped to mine iron ore.");
			return;
		}
		yield_id = best.type == "iron_vein" ? "iron_ore" : "stone";
		yield_qty = eq_id == "stone_pickaxe" ? 2 : 1;
		sfx = "survival/mine_stone.ogg";
	} else if (best.type == "berry_bush") {
		yield_id = "berries";
		yield_qty = 2;
		sfx = "survival/forage_berry.ogg";
	} else if (best.type == "herb_patch") {
		yield_id = "herbs";
		yield_qty = 1;
		sfx = "survival/forage_berry.ogg";
	}

	if (!ps.add_item(yield_id, yield_qty)) {
		ctx.send_speech(ps, MBUF_GAME, true, "Inventory full.");
		return;
	}
	best.charges--;
	if (best.charges <= 0) {
		best.next_respawn_ms = now_ms + uint64(best.respawn_sec) * 1000;
		if (best.type == "tree") ctx.broadcast_sfx_3d(mi.slug, "world", "survival/tree_fall.ogg", best.x, best.y, best.z, 0.9, 28.0);
	}
	ctx.broadcast_sfx_3d(mi.slug, "world", sfx, best.x, best.y, best.z, 0.85, 22.0);
	if (@ps.account != null) { ps.account.gathered_count++; ctx.accounts.dirty = true; }
	ItemDef@ ydef = find_item(yield_id);
	ctx.send_speech(ps, MBUF_GAME, false, "Gathered " + yield_qty + " " + (@ydef != null ? ydef.name : yield_id) + ".");
	ctx.send_inv(ps);
}

void world_handle_craft(ServerCtx@ ctx, PlayerSession@ ps, const string&in recipe_id) {
	MapInstance@ mi = ctx.player_map(ps);
	RecipeDef@ rec = find_recipe(recipe_id);
	if (@rec == null) {
		ctx.send_speech(ps, MBUF_GAME, true, "Unknown recipe.");
		return;
	}
	if (rec.requires_fire && !world_near_emitter_campfire(ctx, mi, ps.x, ps.y, ps.z)) {
		ctx.send_sfx_to(ps, "self", "ui/error.ogg", ps.x, ps.y, ps.z, 0.7);
		ctx.send_speech(ps, MBUF_GAME, true, "Stand near a lit campfire to craft that.");
		return;
	}
	if (rec.requires_bench && !world_near_structure(ctx, mi, ps.x, ps.y, ps.z, "craft_bench", 4.0)) {
		ctx.send_sfx_to(ps, "self", "ui/error.ogg", ps.x, ps.y, ps.z, 0.7);
		ctx.send_speech(ps, MBUF_GAME, true, "Stand near a crafting bench to craft that.");
		return;
	}
	for (uint i = 0; i < rec.ing_ids.length(); i++) {
		if (ps.count_item(rec.ing_ids[i]) < rec.ing_qtys[i]) {
			ItemDef@ missing = find_item(rec.ing_ids[i]);
			ctx.send_sfx_to(ps, "self", "ui/error.ogg", ps.x, ps.y, ps.z, 0.7);
			ctx.send_speech(ps, MBUF_GAME, true, "Need " + rec.ing_qtys[i] + " " + (@missing != null ? missing.name : rec.ing_ids[i]) + ".");
			return;
		}
	}
	for (uint i = 0; i < rec.ing_ids.length(); i++) {
		ps.remove_item(rec.ing_ids[i], rec.ing_qtys[i]);
	}
	ps.add_item(rec.output_id, rec.output_qty);
	ItemDef@ odef = find_item(rec.output_id);
	ctx.broadcast_sfx_3d(ps.current_map, "world", "survival/craft_ok.ogg", ps.x, ps.y, ps.z, 0.85, 16.0);
	ctx.send_speech(ps, MBUF_GAME, false, "Crafted " + rec.output_qty + " " + (@odef != null ? odef.name : rec.output_id) + ".");
	ctx.send_inv(ps);
}

void world_handle_assign_hand(ServerCtx@ ctx, PlayerSession@ ps, const string&in side, int slot_idx) {
	if (@ps == null || !ps.authed || ps.peer_id == 0) return;
	int hand = (side == "left" || side == "1") ? 1 : ((side == "right" || side == "2") ? 2 : 0);
	if (hand == 0 || slot_idx < 0 || slot_idx >= int(ps.inv.length())) {
		ctx.send_sfx_to(ps, "self", "ui/error.ogg", ps.x, ps.y, ps.z, 0.7);
		return;
	}
	ItemStack@ st = ps.inv[uint(slot_idx)];
	ItemDef@ def = find_item(st.id);
	string iname = @def != null ? def.name : st.id;
	string hlabel = (hand == 1) ? "left hand" : "right hand";
	string opp_id = (hand == 1) ? ps.right_hand_id : ps.left_hand_id;
	bool transferred = (opp_id == st.id && ps.count_item(st.id) < 2);
	if (!ps.assign_hand(hand, st.id)) {
		ctx.send_sfx_to(ps, "self", "ui/error.ogg", ps.x, ps.y, ps.z, 0.7);
		return;
	}
	ctx.send_sfx_to(ps, "self", "ui/menu_select.ogg", ps.x, ps.y, ps.z, 0.7);
	if (transferred) {
		ctx.send_speech(ps, MBUF_GAME, true, "Moved " + iname + " to " + hlabel + ".");
	} else {
		ctx.send_speech(ps, MBUF_GAME, true, "Held " + iname + " in " + hlabel + ".");
	}
	ctx.send_inv(ps);
}

void world_handle_select_hand(ServerCtx@ ctx, PlayerSession@ ps, int hand) {
	if (@ps == null || !ps.authed || ps.peer_id == 0) return;
	if (hand != 1 && hand != 2) return;
	ps.reconcile_hands();
	string cur_id = ps.hand_item_id(hand);
	string hlabel = (hand == 1) ? "Left hand" : "Right hand";
	if (cur_id.length() == 0) {
		ctx.send_sfx_to(ps, "self", "ui/menu_edge.ogg", ps.x, ps.y, ps.z, 0.65);
		ctx.send_speech(ps, MBUF_GAME, true, hlabel + " is empty.");
		return;
	}
	ItemDef@ def = find_item(cur_id);
	string iname = @def != null ? def.name : cur_id;
	if (ps.active_hand == hand) {
		if (hand == 1) ps.left_hand_id = "";
		else ps.right_hand_id = "";
		ps.active_hand = 0;
		ctx.send_sfx_to(ps, "self", "ui/menu_back.ogg", ps.x, ps.y, ps.z, 0.7);
		ctx.send_speech(ps, MBUF_GAME, true, "Put " + iname + " away. " + hlabel + " is now empty.");
		ctx.send_inv(ps);
		return;
	}
	ps.active_hand = hand;
	int q = ps.count_item(cur_id);
	string qstr = q > 1 ? (" x" + q) : "";
	ctx.send_sfx_to(ps, "self", "ui/menu_move.ogg", ps.x, ps.y, ps.z, 0.75);
	ctx.send_speech(ps, MBUF_GAME, true, hlabel + ": " + iname + qstr + ".");
	ctx.send_inv(ps);
}

void world_handle_use_item(ServerCtx@ ctx, PlayerSession@ ps) {
	ps.reconcile_hands();
	ItemStack@ eq = ps.active_item();
	if (@eq == null || ps.active_hand == 0) {
		if (ps.left_hand_id.length() > 0 || ps.right_hand_id.length() > 0) {
			ctx.send_speech(ps, MBUF_GAME, false, "No hand selected. Press 1 for left hand or 2 for right hand.");
		} else {
			ctx.send_speech(ps, MBUF_GAME, false, "Both hands are empty. Press I to open inventory.");
		}
		return;
	}
	ItemDef@ def = find_item(eq.id);
	if (@def == null) return;
	string hlabel = ps.active_hand == 1 ? "left hand" : "right hand";
	if (def.category == "food" || def.category == "drink" || def.category == "med") {
		ps.hp = clampi(ps.hp + def.heal_hp, 0, 100);
		ps.hunger = clampi(ps.hunger + def.feed_hunger, 0, 100);
		ps.thirst = clampi(ps.thirst + def.quench_thirst, 0, 100);
		ps.warmth = clampi(ps.warmth + def.warmth_boost, 0, 100);
		bool cured_fracture = false;
		if ((eq.id == "bandage" || eq.id == "splint") && ps.fracture_until_ms > 0) {
			ps.fracture_until_ms = 0;
			cured_fracture = true;
		}
		string used_id = eq.id;
		ps.remove_item(used_id, 1);
		if (used_id == "water_flask_full") ps.add_item("water_flask_empty", 1);
		string sfx = def.category == "drink" ? "survival/drink.ogg" : (def.category == "med" ? "survival/bandage.ogg" : "survival/eat.ogg");
		ctx.broadcast_sfx_3d(ps.current_map, "actors", sfx, ps.x, ps.y, ps.z, 0.8, 12.0);
		string extra = cured_fracture ? " Fracture healed." : "";
		ctx.send_speech(ps, MBUF_GAME, false, "Used " + def.name + "." + extra + " Health " + ps.hp + ", hunger " + ps.hunger + ", thirst " + ps.thirst + ".");
		ctx.send_inv(ps);
	} else if (def.category == "armor") {
		ps.equipped_armor_id = def.id;
		ctx.send_sfx_to(ps, "self", "ui/menu_select.ogg", ps.x, ps.y, ps.z, 0.75);
		ctx.send_speech(ps, MBUF_GAME, false, "Equipped " + def.name + " armor.");
		ctx.send_inv(ps);
	} else if (def.category == "weapon" || def.category == "tool") {
		ctx.send_sfx_to(ps, "self", "ui/menu_select.ogg", ps.x, ps.y, ps.z, 0.7);
		string dmg_note = def.damage > 0 ? (", " + def.damage + " damage") : "";
		ctx.send_speech(ps, MBUF_GAME, false, "Equipped " + def.name + " in " + hlabel + dmg_note + ".");
	} else {
		ctx.send_speech(ps, MBUF_GAME, false, def.name + " x" + eq.qty + " in " + hlabel + ".");
	}
}
