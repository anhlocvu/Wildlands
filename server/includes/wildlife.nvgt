// Server multi-map wildlife & practice bot AI simulation.
// All wildlife spawns strictly from per-map MapAnimalSpawn (E) records using a shared ms respawn timer.

#include "combat.nvgt"

void spawn_mob(ServerCtx@ ctx, MapInstance@ mi, const string&in kind, double sx, double sy, double sz, bool is_bot,
	int spawn_zone_idx = -1, bool leash = false, double lmin_x = 0.0, double lmin_y = 0.0, double lmax_x = 0.0, double lmax_y = 0.0) {
	if (@mi == null) return;
	SpeciesDef@ sp = find_species(kind);
	if (@sp == null) return;
	WildlifeMob mob;
	mob.id = ctx.next_entity_id++;
	mob.kind = sp.kind;
	mob.name = is_bot ? ("Bot_" + mob.id) : sp.name;
	mob.is_bot = is_bot;
	mob.spawn_zone_idx = spawn_zone_idx;
	mob.leash_to_zone = leash;
	mob.leash_min_x = lmin_x;
	mob.leash_min_y = lmin_y;
	mob.leash_max_x = lmax_x;
	mob.leash_max_y = lmax_y;
	mob.x = clampd(sx, 2.0, double(mi.map.width - 2));
	mob.y = clampd(sy, 2.0, double(mi.map.height - 2));
	double sup_z; string sup_surf; bool dw; bool ur;
	if (mi.map.find_support_at(mob.x, mob.y, sz + 1.0, sup_z, sup_surf, dw, ur)) {
		mob.z = sup_z;
	} else {
		mob.z = sz;
	}
	mob.home_x = mob.x; mob.home_y = mob.y; mob.home_z = mob.z;
	mob.facing = random(0, 7) * 45;
	mob.hp = sp.max_hp;
	mob.max_hp = sp.max_hp;
	mob.ai_state = AI_ROAM;
	mi.mobs.insert_last(mob);
}

int count_mobs_by_type(MapInstance@ mi, bool is_bot) {
	if (@mi == null) return 0;
	int c = 0;
	for (uint i = 0; i < mi.mobs.length(); i++) {
		if (mi.mobs[i].is_bot == is_bot) c++;
	}
	return c;
}

int count_mobs_for_zone(MapInstance@ mi, int zi) {
	if (@mi == null) return 0;
	int c = 0;
	for (uint i = 0; i < mi.mobs.length(); i++) {
		WildlifeMob@ m = mi.mobs[i];
		if (!m.is_bot && m.spawn_zone_idx == zi) c++;
	}
	return c;
}

double rand_range(double lo, double hi) {
	if (hi <= lo) return lo;
	return lo + (hi - lo) * (double(random(0, 10000)) / 10000.0);
}

void pick_point_in_spawn_zone(MapInstance@ mi, MapAnimalSpawn@ es, double&out px, double&out py, double&out pz) {
	double xlo = clampd(es.min_x, 2.0, double(mi.map.width - 2));
	double xhi = clampd(es.max_x, 2.0, double(mi.map.width - 2));
	double ylo = clampd(es.min_y, 2.0, double(mi.map.height - 2));
	double yhi = clampd(es.max_y, 2.0, double(mi.map.height - 2));
	if (xlo > xhi) { double t = xlo; xlo = xhi; xhi = t; }
	if (ylo > yhi) { double t = ylo; ylo = yhi; yhi = t; }

	double fb_x = 0.5 * (xlo + xhi);
	double fb_y = 0.5 * (ylo + yhi);
	double fb_z = es.min_z;
	bool have_fb = false;

	for (uint attempt = 0; attempt < 16; attempt++) {
		double cx = rand_range(xlo, xhi);
		double cy = rand_range(ylo, yhi);
		double sup_z; string sup_surf; bool dw; bool ur;
		if (!mi.map.find_support_at(cx, cy, es.max_z + 0.5, sup_z, sup_surf, dw, ur)) continue;
		if (sup_z < es.min_z - 0.5 || sup_z > es.max_z + 0.5) continue;
		string mat;
		if (mi.map.blocked_by_wall(cx, cy, sup_z, 0.35, mat)) continue;
		if (!have_fb) {
			fb_x = cx; fb_y = cy; fb_z = sup_z;
			have_fb = true;
		}
		if (mi.map.is_safe_at(cx, cy, sup_z)) continue;
		px = cx; py = cy; pz = sup_z;
		return;
	}
	if (have_fb) {
		px = fb_x; py = fb_y; pz = fb_z;
		return;
	}
	px = fb_x;
	py = fb_y;
	double gz = mi.map.ground_z_at(px, py, es.max_z + 0.5);
	pz = (gz < double(mi.map.min_z)) ? es.min_z : clampd(gz, es.min_z, es.max_z);
}

void wildlife_sync_map_spawns(ServerCtx@ ctx, MapInstance@ mi) {
	if (@mi == null) return;
	int zcnt = int(mi.map.animal_spawns.length());
	mi.animal_spawn_next_ms.resize(uint(zcnt));
	mi.animal_spawn_waiting.resize(uint(zcnt));
	for (int zi = 0; zi < zcnt; zi++) {
		mi.animal_spawn_next_ms[uint(zi)] = 0;
		mi.animal_spawn_waiting[uint(zi)] = false;
	}

	int[] kept_per_zone(uint(zcnt), 0);
	for (int i = int(mi.mobs.length()) - 1; i >= 0; i--) {
		WildlifeMob@ m = mi.mobs[uint(i)];
		if (m.is_bot) continue;
		if (m.spawn_zone_idx < 0 || m.spawn_zone_idx >= zcnt) {
			mi.mobs.remove_at(uint(i));
			continue;
		}
		MapAnimalSpawn@ es = mi.map.animal_spawns[uint(m.spawn_zone_idx)];
		bool valid_kind = (es.species.find(m.kind) >= 0);
		bool valid_qty = kept_per_zone[uint(m.spawn_zone_idx)] < es.count;
		bool in_box = (m.home_x >= es.min_x - 1.0 && m.home_x <= es.max_x + 1.0 && m.home_y >= es.min_y - 1.0 && m.home_y <= es.max_y + 1.0);
		if (!valid_kind || !valid_qty || !in_box) {
			mi.mobs.remove_at(uint(i));
			continue;
		}
		m.leash_to_zone = es.leash;
		m.leash_min_x = es.min_x;
		m.leash_min_y = es.min_y;
		m.leash_max_x = es.max_x;
		m.leash_max_y = es.max_y;
		kept_per_zone[uint(m.spawn_zone_idx)]++;
	}
}

void wildlife_set_bot_count(ServerCtx@ ctx, int count) {
	count = clampi(count, 0, 50);
	ctx.target_bots = count;
	MapInstance@ mi = ctx.default_map();
	if (@mi == null) return;
	int cur = count_mobs_by_type(mi, true);
	while (cur < count) {
		double sx = double(mi.map.width) * 0.5, sy = double(mi.map.height) * 0.5, sz = 0.0;
		if (mi.map.spawns.length() > 0) {
			sx = mi.map.spawns[0].x; sy = mi.map.spawns[0].y; sz = mi.map.spawns[0].z;
		}
		sx = clampd(sx + double(random(-8, 8)), 3.0, double(mi.map.width - 3));
		sy = clampd(sy + double(random(-8, 8)), 3.0, double(mi.map.height - 3));
		spawn_mob(ctx, mi, "bot_survivor", sx, sy, sz, true);
		cur++;
	}
	for (int i = int(mi.mobs.length()) - 1; i >= 0 && cur > count; i--) {
		if (mi.mobs[uint(i)].is_bot) {
			mi.mobs.remove_at(uint(i));
			cur--;
		}
	}
}

void wildlife_step_spawn_zones(ServerCtx@ ctx, MapInstance@ mi, uint64 now_ms) {
	uint zcnt = mi.map.animal_spawns.length();
	if (zcnt == 0) return;
	if (mi.animal_spawn_next_ms.length() != zcnt || mi.animal_spawn_waiting.length() != zcnt) {
		wildlife_sync_map_spawns(ctx, mi);
	}
	bool map_night = ctx.is_map_night(mi);

	for (uint zi = 0; zi < zcnt; zi++) {
		MapAnimalSpawn@ es = mi.map.animal_spawns[zi];
		if (es.species.length() == 0) continue;

		if ((es.active_time == "day" && map_night) || (es.active_time == "night" && !map_night)) {
			mi.animal_spawn_waiting[zi] = false;
			mi.animal_spawn_next_ms[zi] = 0;
			continue;
		}

		int alive = count_mobs_for_zone(mi, int(zi));
		if (alive < es.count) {
			if (!mi.animal_spawn_waiting[zi]) {
				mi.animal_spawn_waiting[zi] = true;
				mi.animal_spawn_next_ms[zi] = now_ms + uint64(es.interval_ms);
			} else if (now_ms >= mi.animal_spawn_next_ms[zi]) {
				int need = es.count - alive;
				for (int k = 0; k < need; k++) {
					string kind = es.species[uint(random(0, int(es.species.length()) - 1))];
					if (@find_species(kind) == null) continue;
					double px, py, pz;
					pick_point_in_spawn_zone(mi, es, px, py, pz);
					spawn_mob(ctx, mi, kind, px, py, pz, false, int(zi), es.leash, es.min_x, es.min_y, es.max_x, es.max_y);
				}
				mi.animal_spawn_waiting[zi] = false;
				mi.animal_spawn_next_ms[zi] = 0;
			}
		} else {
			mi.animal_spawn_waiting[zi] = false;
			mi.animal_spawn_next_ms[zi] = 0;
		}
	}
}

void wildlife_step_map(ServerCtx@ ctx, MapInstance@ mi, double dt, uint64 now_ms) {
	for (uint i = 0; i < mi.mobs.length(); i++) {
		WildlifeMob@ mob = mi.mobs[i];
		SpeciesDef@ sp = find_species(mob.kind);
		if (@sp == null) continue;

		if (now_ms >= mob.next_sound_ms) {
			mob.next_sound_ms = now_ms + uint64(random(5500, 12000));
			if (sp.snd_idle.length() > 0) {
				ctx.broadcast_sfx_3d(mi.slug, "wildlife", sp.snd_idle, mob.x, mob.y, mob.z, 0.72, 26.0);
			}
		}

		PlayerSession@ target = null;
		double best_d = sp.aggro_range;
		for (uint p = 0; p < ctx.sessions.length(); p++) {
			PlayerSession@ ps = ctx.sessions[p];
			if (!ps.authed || ps.peer_id == 0 || ps.current_map != mi.slug || mi.map.is_safe_at(ps.x, ps.y, ps.z)) continue;
			double d = get_3d_distance(mob.x, mob.y, mob.z, ps.x, ps.y, ps.z);
			if (mob.aggro_peer == ps.peer_id && d <= sp.aggro_range * 1.5) {
				@target = @ps;
				best_d = d;
				break;
			}
			if (d <= best_d) {
				best_d = d;
				@target = @ps;
			}
		}

		if (mob.ai_state == AI_WINDUP) {
			mob.vx = 0.0; mob.vy = 0.0;
			if (now_ms >= mob.windup_end_ms) {
				if (@target != null && get_3d_distance(mob.x, mob.y, mob.z, target.x, target.y, target.z) <= sp.attack_range + 0.6 && !mi.map.is_safe_at(target.x, target.y, target.z)) {
					combat_damage_player(ctx, target, sp.damage, mob.name, false, mob.x, mob.y, mob.z, now_ms);
				}
				mob.ai_state = AI_STALK;
				mob.next_attack_ms = now_ms + sp.cooldown_ms;
			}
			continue;
		}

		if (@target != null && !sp.hostile && !mob.is_bot && best_d <= 8.0) {
			mob.ai_state = AI_FLEE;
			mob.facing = wrap_deg(int(bearing_to(target.x, target.y, mob.x, mob.y) + 0.5));
		} else if (@target != null && (sp.hostile || mob.aggro_peer == target.peer_id)) {
			mob.ai_state = AI_STALK;
			mob.aggro_peer = target.peer_id;
			mob.facing = wrap_deg(int(bearing_to(mob.x, mob.y, target.x, target.y) + 0.5));
			if (best_d <= sp.attack_range && now_ms >= mob.next_attack_ms) {
				mob.ai_state = AI_WINDUP;
				mob.windup_end_ms = now_ms + sp.windup_ms;
				if (sp.snd_attack.length() > 0) {
					ctx.broadcast_sfx_3d(mi.slug, "threat", sp.snd_attack, mob.x, mob.y, mob.z, 0.95, 24.0);
				}
				continue;
			}
		} else {
			mob.ai_state = AI_ROAM;
			mob.aggro_peer = 0;
			if (now_ms >= mob.next_think_ms) {
				mob.next_think_ms = now_ms + uint64(random(2000, 4500));
				if (mob.leash_to_zone && (mob.x < mob.leash_min_x || mob.x > mob.leash_max_x || mob.y < mob.leash_min_y || mob.y > mob.leash_max_y)) {
					double cx = 0.5 * (mob.leash_min_x + mob.leash_max_x);
					double cy = 0.5 * (mob.leash_min_y + mob.leash_max_y);
					mob.facing = wrap_deg(int(bearing_to(mob.x, mob.y, cx, cy) + 0.5));
				} else if (get_2d_distance(mob.x, mob.y, mob.home_x, mob.home_y) > 14.0) {
					mob.facing = wrap_deg(int(bearing_to(mob.x, mob.y, mob.home_x, mob.home_y) + 0.5));
				} else {
					mob.facing = random(0, 7) * 45;
				}
			}
		}

		double spd = mob.ai_state == AI_ROAM ? sp.speed * 0.45 : sp.speed;
		mob.vx = bearing_x(mob.facing) * spd;
		mob.vy = bearing_y(mob.facing) * spd;
		double nx = mob.x + mob.vx * dt;
		double ny = mob.y + mob.vy * dt;
		string mat;
		bool blocked = mi.map.blocked_by_wall(nx, ny, mob.z, 0.35, mat);
		if (!blocked && !mob.is_bot && mi.map.is_safe_at(nx, ny, mob.z)) blocked = true;
		if (!blocked && mob.leash_to_zone) {
			double lx1 = mob.leash_min_x - 3.0, lx2 = mob.leash_max_x + 3.0;
			double ly1 = mob.leash_min_y - 3.0, ly2 = mob.leash_max_y + 3.0;
			bool next_out = (nx < lx1 || nx > lx2 || ny < ly1 || ny > ly2);
			if (next_out) {
				double cx = 0.5 * (mob.leash_min_x + mob.leash_max_x);
				double cy = 0.5 * (mob.leash_min_y + mob.leash_max_y);
				if (get_2d_distance(nx, ny, cx, cy) > get_2d_distance(mob.x, mob.y, cx, cy)) {
					blocked = true;
					mob.aggro_peer = 0;
				}
			}
		}
		double next_sup_z; string next_surf; bool dw; bool ur;
		bool has_floor = mi.map.find_support_at(nx, ny, mob.z + 0.8, next_sup_z, next_surf, dw, ur);
		if (!has_floor || abs(next_sup_z - mob.z) > 2.5) blocked = true;

		if (!blocked) {
			mob.x = nx; mob.y = ny;
			mob.z = next_sup_z;
		} else {
			mob.facing = wrap_deg(mob.facing + 135);
			mob.vx = 0.0; mob.vy = 0.0;
		}
	}
}

void wildlife_step_all(ServerCtx@ ctx, double dt, uint64 now_ms) {
	if (ctx.tick_count % uint64(TICK_HZ * 5) == 0) {
		wildlife_set_bot_count(ctx, ctx.target_bots);
	}
	for (uint i = 0; i < ctx.maps.length(); i++) {
		wildlife_step_spawn_zones(ctx, ctx.maps[i], now_ms);
		wildlife_step_map(ctx, ctx.maps[i], dt, now_ms);
	}
}
