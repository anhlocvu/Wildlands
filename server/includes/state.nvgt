// Shared authoritative server state, multi-map MapInstance, session structures, and network helper methods.

#include "../../common/map.nvgt"
#include "../../common/items.nvgt"
#include "../../common/compass.nvgt"
#include "accounts.nvgt"
#include "logger.nvgt"

const uint AI_IDLE = 0;
const uint AI_ROAM = 1;
const uint AI_FLEE = 2;
const uint AI_STALK = 3;
const uint AI_WINDUP = 4;
const uint MAX_UNDO_STEPS = 15;

class PlayerSession {
	uint64 peer_id = 0;
	string ip = "";
	bool handshake_ok = false;
	bool authed = false;
	bool is_guest = false;
	bool client_is_source = false;
	AccountRecord@ account = null;

	string name = "";
	int rank = RANK_PLAYER;
	string current_map = "wildlands_valley";
	double x = 50.0, y = 46.0, z = 0.0;
	double vx = 0.0, vy = 0.0, vz = 0.0;
	int facing = 0;
	bool on_ground = true;
	double fall_start_z = 0.0;
	bool fall_air_sfx_sent = false;
	uint64 fracture_until_ms = 0;
	uint64 last_climb_ms = 0;
	uint64 last_hazard_ms = 0;

	int hp = 100;
	int hunger = 100;
	int thirst = 100;
	int stamina = 100;
	int warmth = 100;

	uint input_mask = 0;
	bool blocking = false;
	uint64 block_until_ms = 0;
	uint64 last_move_ms = 0;
	bool was_moving = false;
	double step_rem_x = 0.0;
	double step_rem_y = 0.0;
	uint64 last_step_sfx_ms = 0;
	uint64 last_wall_bump_ms = 0;
	uint64 last_attack_ms = 0;
	uint64 last_gather_ms = 0;
	uint64 last_chat_ms = 0;
	uint64 last_vital_tick_ms = 0;
	uint64 last_heartbeat_ms = 0;
	uint64 last_vital_warn_ms = 0;
	uint64 last_snapshot_ms = 0;
	string last_pm_sender = "";

	string last_zone = "";
	string last_surface = "";

	ItemStack@[] inv;
	string left_hand_id = "";
	string right_hand_id = "";
	string equipped_armor_id = "";
	int active_hand = 0; // 0=none, 1=left, 2=right

	bool builder_mode = false;
	bool builder_noclip = false;
	string builder_edit_map = "wildlands_valley";
	int builder_cx = 50, builder_cy = 46, builder_cz = 0;
	bool builder_has_mark = false;
	int builder_mx = 0, builder_my = 0, builder_mz = 0;

	string duel_invite_from = "";
	string duel_opponent = "";
	uint64 duel_until_ms = 0;
	bool debug_readout = false;

	uint64 disconnected_at_ms = 0;
	uint64 grace_until_ms = 0;
	uint64 join_ms = 0;
	uint64 last_playtime_ms = 0;

	bool is_fractured(uint64 now_ms) const {
		return fracture_until_ms > now_ms;
	}

	void init_starter_inv() {
		inv.resize(0);
		inv.insert_last(ItemStack("stone_axe", 1));
		inv.insert_last(ItemStack("water_flask_full", 1));
		inv.insert_last(ItemStack("berries", 4));
		inv.insert_last(ItemStack("torch", 1));
		left_hand_id = "";
		right_hand_id = "";
		equipped_armor_id = "";
		active_hand = 0;
	}

	void clear_inv_and_hands() {
		inv.resize(0);
		left_hand_id = "";
		right_hand_id = "";
		equipped_armor_id = "";
		active_hand = 0;
	}

	void reconcile_hands() {
		if (left_hand_id.length() > 0 && count_item(left_hand_id) <= 0) left_hand_id = "";
		if (right_hand_id.length() > 0 && count_item(right_hand_id) <= 0) right_hand_id = "";
		if (equipped_armor_id.length() > 0 && count_item(equipped_armor_id) <= 0) equipped_armor_id = "";
		if (left_hand_id.length() > 0 && left_hand_id == right_hand_id && count_item(left_hand_id) < 2) {
			if (active_hand == 2) left_hand_id = "";
			else right_hand_id = "";
		}
		if (active_hand == 1 && left_hand_id.length() == 0) active_hand = 0;
		if (active_hand == 2 && right_hand_id.length() == 0) active_hand = 0;
		if (active_hand < 0 || active_hand > 2) active_hand = 0;
	}

	void sync_inv_to_account() {
		if (@account == null || is_guest) return;
		reconcile_hands();
		account.has_saved_inv = true;
		account.saved_inv.resize(0);
		for (uint i = 0; i < inv.length(); i++) {
			if (inv[i].qty > 0) account.saved_inv.insert_last(ItemStack(inv[i].id, inv[i].qty));
		}
		account.left_hand_id = left_hand_id;
		account.right_hand_id = right_hand_id;
		account.equipped_armor_id = equipped_armor_id;
		account.active_hand = active_hand;
	}

	void restore_inv_from_account() {
		if (@account == null || !account.has_saved_inv) {
			init_starter_inv();
			return;
		}
		inv.resize(0);
		for (uint i = 0; i < account.saved_inv.length() && inv.length() < uint(MAX_INV_SLOTS); i++) {
			ItemStack@ st = account.saved_inv[i];
			if (@st != null && st.qty > 0 && @find_item(st.id) != null) {
				inv.insert_last(ItemStack(st.id, st.qty));
			}
		}
		left_hand_id = account.left_hand_id;
		right_hand_id = account.right_hand_id;
		equipped_armor_id = account.equipped_armor_id;
		active_hand = account.active_hand;
		reconcile_hands();
	}

	bool assign_hand(int hand, const string&in item_id) {
		if (hand != 1 && hand != 2) return false;
		int cnt = count_item(item_id);
		if (cnt <= 0) return false;
		if (hand == 1) {
			if (right_hand_id == item_id && cnt < 2) {
				right_hand_id = "";
				if (active_hand == 2) active_hand = 0;
			}
			left_hand_id = item_id;
		} else {
			if (left_hand_id == item_id && cnt < 2) {
				left_hand_id = "";
				if (active_hand == 1) active_hand = 0;
			}
			right_hand_id = item_id;
		}
		reconcile_hands();
		return true;
	}

	int count_item(const string&in item_id) {
		int total = 0;
		for (uint i = 0; i < inv.length(); i++) {
			if (inv[i].id == item_id) total += inv[i].qty;
		}
		return total;
	}

	bool add_item(const string&in item_id, int qty) {
		if (qty <= 0) return false;
		ItemDef@ def = find_item(item_id);
		if (@def == null) return false;
		int rem = qty;
		for (uint i = 0; i < inv.length() && rem > 0; i++) {
			if (inv[i].id == item_id && inv[i].qty < def.stack_max) {
				int add = def.stack_max - inv[i].qty;
				if (add > rem) add = rem;
				inv[i].qty += add;
				rem -= add;
			}
		}
		while (rem > 0 && inv.length() < uint(MAX_INV_SLOTS)) {
			int add = rem > def.stack_max ? def.stack_max : rem;
			inv.insert_last(ItemStack(item_id, add));
			rem -= add;
		}
		return rem == 0;
	}

	bool remove_item(const string&in item_id, int qty) {
		if (qty <= 0 || count_item(item_id) < qty) return false;
		int rem = qty;
		for (int i = int(inv.length()) - 1; i >= 0 && rem > 0; i--) {
			if (inv[uint(i)].id == item_id) {
				if (inv[uint(i)].qty <= rem) {
					rem -= inv[uint(i)].qty;
					inv.remove_at(uint(i));
				} else {
					inv[uint(i)].qty -= rem;
					rem = 0;
				}
			}
		}
		reconcile_hands();
		return true;
	}

	ItemStack@ active_item() {
		string target_id = active_hand == 1 ? left_hand_id : (active_hand == 2 ? right_hand_id : "");
		if (target_id.length() == 0) return null;
		for (uint i = 0; i < inv.length(); i++) {
			if (inv[i].id == target_id && inv[i].qty > 0) return inv[i];
		}
		return null;
	}

	string hand_item_id(int hand) const {
		return hand == 1 ? left_hand_id : (hand == 2 ? right_hand_id : "");
	}
}

class ResourceNode {
	uint64 id = 0;
	string type;
	double x = 0.0, y = 0.0, z = 0.0;
	int charges = 3;
	int max_charges = 3;
	int respawn_sec = 45;
	uint64 next_respawn_ms = 0;
}

class WorldStructure {
	uint64 id = 0;
	string map_name;
	string type;
	string owner;
	double x = 0.0, y = 0.0, z = 0.0;
	int facing = 0;
	int hp = 100, max_hp = 100;
	bool locked = false;
	bool is_open = false;
	int fuel_sec = 0;
	ItemStack@[] chest_items;
}

class LootDrop {
	uint64 id = 0;
	string item_id;
	int qty = 1;
	double x = 0.0, y = 0.0, z = 0.0;
	uint64 expires_ms = 0;
}

class ArrowProjectile {
	uint64 id = 0;
	uint64 owner_peer = 0;
	string owner_name;
	double x = 0.0, y = 0.0, z = 0.0;
	double vx = 0.0, vy = 0.0, vz = 0.0;
	int damage = 28;
	uint64 expires_ms = 0;
}

class WildlifeMob {
	uint64 id = 0;
	string kind;
	string name;
	uint ai_state = AI_ROAM;
	double x = 0.0, y = 0.0, z = 0.0;
	double vx = 0.0, vy = 0.0;
	int facing = 0;
	int hp = 50, max_hp = 50;
	double home_x = 0.0, home_y = 0.0, home_z = 0.0;
	int spawn_zone_idx = -1;
	bool leash_to_zone = false;
	double leash_min_x = 0.0, leash_min_y = 0.0, leash_max_x = 0.0, leash_max_y = 0.0;
	uint64 aggro_peer = 0;
	uint64 next_think_ms = 0;
	uint64 windup_end_ms = 0;
	uint64 next_attack_ms = 0;
	uint64 next_sound_ms = 0;
	bool is_bot = false;
}

class MapInstance {
	string slug;
	string file_path;
	WorldMap map;
	ResourceNode@[] nodes;
	WildlifeMob@[] mobs;
	LootDrop@[] drops;
	ArrowProjectile@[] arrows;
	uint64[] animal_spawn_next_ms;
	bool[] animal_spawn_waiting;
	string[][] undo_history;

	void push_undo() {
		string[] snap = map.raw_lines;
		undo_history.insert_last(snap);
		while (undo_history.length() > MAX_UNDO_STEPS) {
			undo_history.remove_at(0);
		}
	}
}

class ServerCtx {
	network@ net = null;
	ServerLogger logger;
	AccountStore accounts;
	StaffReportStore report_store;

	MapInstance@[] maps;
	string default_map_slug = "wildlands_valley";
	string active_map_path = "maps/wildlands_valley.map";
	string maps_dir = "maps";
	string data_dir = "data";
	string objects_db_path = "data/world_objects.dat";

	uint16 port = DEFAULT_PORT;
	bool test_mode = false;
	bool allow_guests = false;
	bool headless = false;
	bool maintenance_mode = false;
	uint64 bind_delay_ms = 0;
	int target_bots = 0;
	int guest_seq = 1;
	uint64 next_entity_id = 1;
	uint64 tick_count = 0;
	uint64 started_ms = 0;
	uint64 worst_tick_ms_report = 0;

	// Shutdown / Restart lifecycle
	bool shutdown_pending = false;
	bool restart_pending = false;
	uint64 shutdown_at_ms = 0;
	uint64 next_shutdown_announce_ms = 0;
	string shutdown_reason = "";

	// Environment & News
	string server_name = "Wildlands Valley Official";
	string motd = "Welcome to Wildlands Online!";
	string[] changelog;
	int cycle_sec = 300;
	bool is_night = false;
	bool is_raining = false;
	uint64 next_weather_ms = 0;
	uint64 next_autosave_ms = 0;

	PlayerSession@[] sessions;
	WorldStructure@[] structures;
	bool objects_dirty = false;

	MapInstance@ find_map(const string&in key) {
		string low = key.trim_whitespace().lower();
		if (low.length() == 0) return null;
		for (uint i = 0; i < maps.length(); i++) {
			if (maps[i].slug.lower() == low || maps[i].map.name.lower() == low) return maps[i];
		}
		return null;
	}

	MapInstance@ default_map() {
		MapInstance@ m = find_map(default_map_slug);
		if (@m != null) return m;
		return maps.length() > 0 ? maps[0] : null;
	}

	MapInstance@ player_map(PlayerSession@ ps) {
		if (@ps != null) {
			MapInstance@ m = find_map(ps.current_map);
			if (@m != null) return m;
		}
		return default_map();
	}

	bool struct_on_map(WorldStructure@ st, MapInstance@ mi) {
		if (@st == null || @mi == null) return false;
		string sn = st.map_name.lower();
		return sn == mi.slug.lower() || sn == mi.map.name.lower();
	}

	int count_players_on_map(const string&in slug) {
		string low = slug.lower();
		int c = 0;
		for (uint i = 0; i < sessions.length(); i++) {
			if (sessions[i].authed && sessions[i].peer_id != 0 && sessions[i].current_map.lower() == low) c++;
		}
		return c;
	}

	bool is_map_night(MapInstance@ mi) {
		if (@mi != null) {
			if (mi.map.time_mode == "night") return true;
			if (mi.map.time_mode == "day") return false;
		}
		return is_night;
	}

	bool is_map_raining(MapInstance@ mi) {
		if (@mi != null && !mi.map.weather_enabled) return false;
		return is_raining;
	}

	PlayerSession@ find_session_by_peer(uint64 peer_id) {
		if (peer_id == 0) return null;
		for (uint i = 0; i < sessions.length(); i++) {
			if (sessions[i].peer_id == peer_id) return sessions[i];
		}
		return null;
	}

	PlayerSession@ find_session_by_name(const string&in name) {
		string low = sanitize_name(name).lower();
		if (low.length() == 0) return null;
		for (uint i = 0; i < sessions.length(); i++) {
			if (sessions[i].authed && sessions[i].name.lower() == low) return sessions[i];
		}
		return null;
	}

	void send_ch(uint64 peer_id, uint8 ch, const string&in msg, bool reliable = true) {
		if (@net == null || peer_id == 0) return;
		if (!fits_udp(msg) && !reliable) return;
		net.send(peer_id, msg, ch, reliable);
	}

	void send_speech(PlayerSession@ ps, uint buf_ch, bool interrupt, const string&in text) {
		if (@ps == null || ps.peer_id == 0) return;
		string pkt = pkt_4("SPEAK", "" + buf_ch, interrupt ? "1" : "0", wire_escape(text));
		send_ch(ps.peer_id, CH_SPEECH, pkt, true);
	}

	void broadcast_speech(uint buf_ch, bool interrupt, const string&in text) {
		string pkt = pkt_4("SPEAK", "" + buf_ch, interrupt ? "1" : "0", wire_escape(text));
		for (uint i = 0; i < sessions.length(); i++) {
			if (sessions[i].authed && sessions[i].peer_id != 0) send_ch(sessions[i].peer_id, CH_SPEECH, pkt, true);
		}
	}

	void broadcast_speech_map(const string&in map_slug, uint buf_ch, bool interrupt, const string&in text) {
		string pkt = pkt_4("SPEAK", "" + buf_ch, interrupt ? "1" : "0", wire_escape(text));
		for (uint i = 0; i < sessions.length(); i++) {
			PlayerSession@ p = sessions[i];
			if (p.authed && p.peer_id != 0 && p.current_map.lower() == map_slug.lower()) {
				send_ch(p.peer_id, CH_SPEECH, pkt, true);
			}
		}
	}

	void broadcast_staff_speech(const string&in text, bool with_alert = false) {
		string pkt = pkt_4("SPEAK", "" + MBUF_SYSTEM, "0", wire_escape(text));
		for (uint i = 0; i < sessions.length(); i++) {
			PlayerSession@ p = sessions[i];
			if (p.authed && p.peer_id != 0 && p.rank >= RANK_MOD) {
				send_ch(p.peer_id, CH_SPEECH, pkt, true);
				if (with_alert) send_sfx_to(p, "self", "ui/staff_alert.ogg", p.x, p.y, p.z, 0.8);
			}
		}
	}

	void send_sfx_to(PlayerSession@ ps, const string&in layer, const string&in sfx, double sx, double sy, double sz, double vol = 1.0) {
		if (@ps == null || ps.peer_id == 0) return;
		string pkt = pkt_build("SFX", {layer, sfx, fmt2(sx), fmt2(sy), fmt2(sz), fmt2(vol), "1"});
		send_ch(ps.peer_id, CH_AUDIO, pkt, true);
	}

	void broadcast_sfx_3d(const string&in map_slug, const string&in layer, const string&in sfx, double sx, double sy, double sz, double vol = 1.0, double max_dist = EARSHOT_RADIUS) {
		string pkt = pkt_build("SFX", {layer, sfx, fmt2(sx), fmt2(sy), fmt2(sz), fmt2(vol), "1"});
		string mlow = map_slug.lower();
		for (uint i = 0; i < sessions.length(); i++) {
			PlayerSession@ ps = sessions[i];
			if (!ps.authed || ps.peer_id == 0 || ps.current_map.lower() != mlow) continue;
			if (get_3d_distance(ps.x, ps.y, ps.z, sx, sy, sz) <= max_dist) {
				send_ch(ps.peer_id, CH_AUDIO, pkt, true);
			}
		}
	}

	void send_control(PlayerSession@ ps, const string&in pkt) {
		if (@ps == null || ps.peer_id == 0) return;
		send_ch(ps.peer_id, CH_CONTROL, pkt, true);
	}

	void send_inv(PlayerSession@ ps) {
		if (@ps == null) return;
		ps.reconcile_hands();
		if (@ps.account != null && !ps.is_guest) {
			ps.sync_inv_to_account();
			accounts.dirty = true;
		}
		if (ps.peer_id == 0) return;
		string list = encode_item_stacks(ps.inv);
		string lh = ps.left_hand_id.length() > 0 ? ps.left_hand_id : "-";
		string rh = ps.right_hand_id.length() > 0 ? ps.right_hand_id : "-";
		string arm = ps.equipped_armor_id.length() > 0 ? ps.equipped_armor_id : "-";
		send_control(ps, pkt_build("INV", {"" + ps.active_hand, lh, rh, arm, list}));
	}

	string encode_obj(WorldStructure@ st) {
		return st.id + "|" + st.type + "|" + fmt2(st.x) + "|" + fmt2(st.y) + "|" + fmt2(st.z) + "|"
			+ st.facing + "|" + st.hp + "|" + st.max_hp + "|" + (st.locked ? "1" : "0") + "|"
			+ (st.is_open ? "1" : "0") + "|" + wire_escape(st.owner);
	}

	void broadcast_obj(const string&in op, WorldStructure@ st) {
		string pkt = "MAP_OBJ|" + op + "|" + encode_obj(st);
		MapInstance@ mi = find_map(st.map_name);
		string slug_l = @mi != null ? mi.slug.lower() : st.map_name.lower();
		for (uint i = 0; i < sessions.length(); i++) {
			PlayerSession@ p = sessions[i];
			if (p.authed && p.peer_id != 0 && p.current_map.lower() == slug_l) {
				send_ch(p.peer_id, CH_CONTROL, pkt, true);
			}
		}
	}

	void sync_map_occluders(MapInstance@ mi) {
		if (@mi == null) return;
		mi.map.dyn_occluders.resize(0);
		for (uint i = 0; i < structures.length(); i++) {
			WorldStructure@ st = structures[i];
			if (!struct_on_map(st, mi)) continue;
			StructDef@ def = find_struct(st.type);
			if (@def == null) continue;
			DynOccluder occ;
			occ.id = st.id;
			occ.x = st.x; occ.y = st.y; occ.z = st.z;
			occ.half_w = def.half_w;
			occ.height = def.height;
			occ.blocks_move = def.blocks_move && !(def.is_door && st.is_open);
			occ.occludes_sound = def.occludes_sound && !(def.is_door && st.is_open);
			occ.is_floor = (st.type == "wood_floor");
			occ.material = "wood";
			mi.map.dyn_occluders.insert_last(occ);
		}
	}

	void sync_all_map_occluders() {
		for (uint i = 0; i < maps.length(); i++) sync_map_occluders(maps[i]);
	}

	void load_soft_data() {
		string motd_path = data_dir + "/motd.txt";
		if (file_exists(motd_path)) {
			string raw = file_get_contents(motd_path).replace("\r", "", true).trim_whitespace();
			if (raw.length() > 0) motd = raw;
		} else {
			logger.log("WARN", motd_path + " not found; using default MOTD.");
		}
		changelog.resize(0);
		string ch_path = data_dir + "/changelog.txt";
		if (file_exists(ch_path)) {
			string raw = file_get_contents(ch_path).replace("\r", "", true);
			string[]@ lines = split_keep_empty(raw, "\n");
			for (uint i = 0; i < lines.length(); i++) {
				string ln = lines[i].trim_whitespace();
				if (ln.length() > 0) changelog.insert_last(ln);
			}
		}
	}

	void send_news(PlayerSession@ ps) {
		send_control(ps, pkt_2("MOTD", wire_escape(motd)));
		for (uint i = 0; i < changelog.length() && i < 10; i++) {
			send_control(ps, pkt_3("CHANGELOG", "" + i, wire_escape(changelog[i])));
		}
	}

	bool send_map_sync(PlayerSession@ ps) {
		MapInstance@ mi = player_map(ps);
		if (@mi == null) return false;
		ps.current_map = mi.slug;
		string ser = mi.map.serialize();
		string esc = wire_escape(ser);
		uint chunks = (esc.length() + uint(MAP_CHUNK_BYTES) - 1) / uint(MAP_CHUNK_BYTES);
		if (chunks == 0) chunks = 1;
		send_control(ps, pkt_build("MAP_HDR", {
			wire_escape(mi.slug),
			wire_escape(mi.map.name),
			"" + mi.map.width,
			"" + mi.map.height,
			"" + mi.map.min_z,
			"" + mi.map.max_z,
			mi.map.default_surface,
			"" + chunks
		}));
		for (uint i = 0; i < chunks; i++) {
			uint start = i * uint(MAP_CHUNK_BYTES);
			uint len = start + uint(MAP_CHUNK_BYTES) <= esc.length() ? uint(MAP_CHUNK_BYTES) : esc.length() - start;
			string pkt = pkt_3("MAP_CHK", "" + i, esc.substr(start, len));
			if (!fits_udp(pkt)) {
				logger.log("ERROR", "MAP_CHK exceeded MAX_UDP_PAYLOAD");
				return false;
			}
			send_control(ps, pkt);
		}
		for (uint i = 0; i < structures.length(); i++) {
			if (struct_on_map(structures[i], mi)) {
				send_control(ps, "MAP_OBJ|add|" + encode_obj(structures[i]));
			}
		}
		return true;
	}
}
